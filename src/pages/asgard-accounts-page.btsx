import { useState } from 'octane'
import { NuqsAdapter } from '@octanejs/nuqs/adapters/react'
import Tabs from '@/components/ui/Tabs.btsx'
import type { TabItem } from '@/components/ui/Tabs.btsx'
import AccountsActivity from '@/components/asgard/accounts-activity.btsx'
import AccountsPanel from '@/components/asgard/accounts-panel.btsx'
import AccountsSettings from '@/components/asgard/accounts-settings.btsx'

module
  const tabs: TabItem[] = [
    { id: 'accounts', label: 'Accounts' },
    { id: 'activity', label: 'Activity' },
    { id: 'settings', label: 'Settings' }
  ]

setup
  const [activeId, setActiveId] = useState('accounts')

section(className='flex min-h-0 flex-col')
  header(className='asgard-topbar')
    div(className='min-w-0')
      div(className='flex items-center gap-2.5')
      h1(className='font-sans text-base font-[450] leading-none tracking-tight text-foreground') Accounts

  div(className='asgard-topbar-tabs')
    Tabs(activeId={activeId} items={tabs} onSelect={setActiveId} label='Accounts sections')

  if activeId === 'activity'
    div(className='h-[calc(100dvh-108px)] overflow-y-auto px-4 pt-4 pb-16 md:px-6')
      AccountsActivity
  elseif activeId === 'settings'
    div(className='h-[calc(100dvh-108px)] overflow-y-auto px-4 pt-4 pb-16 md:px-6')
      AccountsSettings
  else
    div(className='px-4 pb-16 md:px-6 h-[calc(100dvh-108px)] overflow-scroll')
      NuqsAdapter
        AccountsPanel
