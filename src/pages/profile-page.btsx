import { useCallback, useEffect, useState } from 'octane'
import type { FunctionReturnType } from 'convex/server'
import { Distribution, Panel, StatTile } from '@/components/overview'
import Tabs from '@/components/ui/Tabs.btsx'
import type { TabItem } from '@/components/ui/Tabs.btsx'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { usePendingTronAccount } from '@/hooks/use-pending-tron-account'
import { formatLedgerAmount, formatLedgerLabel } from '@/lib/asgard/account-detail'
import { toMyHouseItems } from '@/lib/accounts/my-houses'
import { convexClient } from '@/lib/convex-client'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { formatPeso } from '@/lib/format'
import { GAMES } from '@/lib/games'
import { Icon } from '@/lib/icons'
import { formatCount, formatPercent, formatRelativeTime } from '@/lib/overview/metrics'
import { replaceRoute } from '@/lib/routing/navigation'
import type { PracticePlayRow } from '@/lib/profile/record'
import { readPracticeStats } from '@/lib/profile/stats'
import { clearPendingTronAccount } from '@/lib/tronweb/pending-account'
import { formatDraw } from '@/lib/tickets/format'
import { cn } from '@/lib/utils'
import { api } from '../../convex/_generated/api'
import type { Id } from '../../convex/_generated/dataModel'
import { MY_HISTORY_LIMIT } from '../../convex/ledger/d'
import { DEFAULT_PLAY_PAGE, PLAY_HISTORY_LIMIT, TICKET_DETAIL_LIMIT } from '../../convex/plays/d'

module
  type Movement = FunctionReturnType<typeof api.ledger.q.myLedgerHistory>[number]
  type MyTicket = FunctionReturnType<typeof api.tickets.q.mine>[number]

  // A read that has not answered yet, or one that failed, is `undefined`. Each
  // panel falls back to its own empty list, so no panel can empty another.
  const EMPTY_MOVEMENTS: Movement[] = []
  const EMPTY_PLAYS: PracticePlayRow[] = []
  const EMPTY_TICKETS: MyTicket[] = []

  // Both panels are fixed-height, so both reads are capped rather than paged.
  // The plays read takes the backend's own default page: a row carries up to
  // TICKET_DETAIL_LIMIT ticket details, so a live subscription over the full
  // PLAY_HISTORY_LIMIT would be a large payload for a panel that leads with a
  // summary. The statistics therefore describe this window, and say so.
  const MOVEMENT_ARGS = { limit: MY_HISTORY_LIMIT }
  const PLAYS_ARGS = { limit: DEFAULT_PLAY_PAGE }
  const PLAY_FEED_LIMIT = 10
  // The newest tickets only: `tickets.q.mine` can return up to its own cap of
  // 500 for the board, which is more than a profile tab should subscribe to.
  const TICKETS_ARGS = { limit: 50 }

  const readingLabelClass = 'font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground'
  const chipClass = 'rounded px-1.5 py-1 font-mono text-2xs uppercase tracking-wider'
  const blankClass = 'rounded-lg border border-dashed border-border/60 px-4 py-10 text-center text-sm text-muted-foreground'
  const ticketColumns = 'xl:grid-cols-[minmax(0,1.1fr)_minmax(14rem,1.75fr)_minmax(0,.65fr)_minmax(0,1.2fr)_minmax(0,.6fr)_minmax(0,.75fr)_minmax(0,.85fr)]'

  // A credit that came in, or a draw that paid: never colour alone, since each
  // one sits beside a figure that carries its own sign.
  const POSITIVE_TONE = 'text-emerald-700 dark:text-emerald-400'

  const memberSinceFormatter = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' })

  /** Credits are counted, not measured: a balance is shown whole, never compacted. */
  const formatCredits = (value: number) => value.toLocaleString('en-US')

  const formatMemberSince = (timestamp: number | null) =>
    timestamp === null ? '—' : memberSinceFormatter.format(timestamp)

  /**
   * A net result is a direction as much as an amount, so the minus sits outside
   * the peso sign rather than inside the figure.
   */
  const formatNet = (net: number) => (net < 0 ? `−${formatPeso(-net)}` : formatPeso(net))

  const formatHits = (hits: number) => (hits === 1 ? '1 hit' : `${hits} hits`)

  // A draw is stored in draw order, because reproducing a simulated draw needs
  // the order the drum spat the balls out. A reader wants them ascending, the
  // way `DrawHistory` shows the same draw, so the copy is sorted here.
  const formatDrawnBalls = (balls: readonly number[]) => [...balls].sort((a, b) => a - b).join(' · ')

  // A read that has not answered is not an account where nothing happened, so
  // the two states are never given the same sentence.
  const UNREAD_MOVEMENTS = 'Your credit movements have not been read on this load.'
  const UNREAD_PLAYS = 'Your practice draws have not been read on this load.'
  const UNREAD_TICKETS = 'Your tickets have not been read on this load.'

  // A ticket's state is carried by the word, with colour only as a second cue.
  const TICKET_STATUS_TONE: Record<MyTicket['status'], string> = {
    pending: 'bg-orange-500/15 text-orange-700 dark:text-orange-200',
    won: 'bg-chart-good/15 text-emerald-700 dark:text-emerald-400',
    lost: 'bg-foreground/5 text-muted-foreground'
  }

component TicketReading
  props { label, value, className }: { label: string; value: string; className?: string }
  div(className={cn('min-w-0', className)})
    dt(className={cn(readingLabelClass, 'text-[9px] mb-0.5 lg:sr-only')}) #{label}
    dd(className='text-xs tabular-nums sm:text-sm text-foreground') #{value}

component WalletMovements
  props { entries, now }: { entries: Movement[]; now: number }
  ul(className='overview-feed')
    each entry in entries key entry._id
      li(className='grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-1 lg:flex lg:items-center')
        span(className='row-start-2 font-mono text-2xs text-muted-foreground lg:w-20 lg:shrink-0') #{formatRelativeTime(entry.createdAt, now)}
        div(className='col-start-1 row-start-1 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 lg:flex-1')
          span(className='min-w-0 text-sm text-foreground') #{formatLedgerLabel(entry)}
          if entry.bucket === 'held'
            span(className={cn(chipClass, 'bg-foreground/5 text-muted-foreground')}) held
        span(className={cn('col-start-2 row-start-1 text-right font-mono text-sm tabular-nums lg:min-w-20', entry.amount < 0 ? 'text-destructive' : POSITIVE_TONE)}) #{formatLedgerAmount(entry.amount)}
        span(className='hidden min-w-20 text-right font-mono text-2xs tabular-nums text-muted-foreground/70 lg:inline') #{formatCredits(entry.balanceAfter)}

// What a panel says when it has nothing to show, which is never an error here.
component Blank
  props { message }: { message: string }
  p(className={blankClass}) #{message}
component UserAvatar
  props { avatarUrl, onError }: { avatarUrl: string | null; onError: VoidFunction }
  if avatarUrl
    img(
      ~ src={avatarUrl}
      ~ alt=''
      ~ referrerPolicy='no-referrer'
      ~ onError={onError}
      ~ className='size-10 shrink-0 rounded-full border object-cover sm:size-12'
      ~ )
  else
    div(className='grid size-10 shrink-0 place-items-center rounded-full bg-foreground/5 text-muted-foreground sm:size-12')
      Icon(name='person' className='size-7')


setup
  const { user, isLoading: isAuthLoading } = useFirebaseUser()
  const [brokenPhotoUrl, setBrokenPhotoUrl] = useState<string | null>(null)

  const isSignedIn = user !== null

  // This page is only for a signed-in user. Arriving signed out, or signing out
  // while here, goes home, and replaces the entry so Back does not return to a
  // page with nothing to show. It waits for the session check, so a signed-in
  // reload is not bounced while Firebase is still restoring the user.
  useEffect(() => {
    if (!isAuthLoading && !isSignedIn) replaceRoute('/')
  }, [isAuthLoading, isSignedIn])

  // Every read is the caller's own, derived from the Convex identity. The hook
  // answers `undefined` until a value arrives — and leaves it `undefined` where
  // there is no client or the query failed — so a panel that cannot read stays
  // on its empty state while the rest of the page works.
  const profile = useConvexQuery(api.users.q.current, {}, { enabled: isSignedIn })
  const wallet = useConvexQuery(api.ledger.q.myWallet, {}, { enabled: isSignedIn })
  const movements = useConvexQuery(api.ledger.q.myLedgerHistory, MOVEMENT_ARGS, { enabled: isSignedIn })
  const plays = useConvexQuery(api.plays.q.mine, PLAYS_ARGS, { enabled: isSignedIn })
  const myHouses = useConvexQuery(api.accounts.q.myHouses, {}, { enabled: isSignedIn })
  const tickets = useConvexQuery(api.tickets.q.mine, TICKETS_ARGS, { enabled: isSignedIn })
  const claimableTopups = useConvexQuery(api.money.topups.claimable, {}, { enabled: isSignedIn })
  // A claimed top-up lands in the house's float, not in the caller's own
  // wallet, so the Wallet tab reads both. Empty for anyone who fronts no house.
  const houseWallets = useConvexQuery(api.ledger.q.myHouseWallets, {}, { enabled: isSignedIn }) ?? []

  const now = Date.now()
  const entries = movements ?? EMPTY_MOVEMENTS
  const rows = plays ?? EMPTY_PLAYS
  const playFeed = rows.slice(0, PLAY_FEED_LIMIT)
  const stats = readPracticeStats(rows)
  // Read out of `stats` so the template can narrow them; `bestDraw` is already
  // null when nothing was won, so the tile is simply absent then.
  const bestDraw = stats.bestDraw
  const favouriteGame = stats.favouriteGame

  // A user who has never been allocated credits has no wallet row at all. That
  // is a zero balance, not a failure, so `null` reads as one — while `undefined`
  // is no answer at all and reads as an em dash. That the balance is missing is
  // a different fact from its being zero, and showing `0` for both would hide
  // one of them (the rule `lib/asgard/account-detail.ts` already states).
  const balanceValue = wallet === undefined ? '—' : `₱${formatCredits(wallet?.available ?? 0)}`
  // `null` is an answer — there is no wallet, so nothing was ever allocated.
  // `undefined` is no answer yet, which must not be reported as an allocation
  // that never happened.
  const balanceCaption =
    wallet === undefined
      ? 'Your credit account has not been read on this load.'
      : wallet === null
        ? 'No credits have been allocated to you yet.'
        : wallet.status === 'frozen'
          ? 'Available to play with. This wallet is frozen.'
          : 'Available to play with.'

  // `null` is an answer — the identity is known and carries no `users` row yet.
  // `undefined` is no answer at all, which says nothing about the account, so it
  // reads as an em dash rather than as a record that is missing.
  const accountRecordLabel = profile === undefined ? '—' : profile === null ? 'Not linked yet' : 'Linked'

  // Same distinction, per panel: `undefined` is the whole window between
  // Firebase resolving from local persistence and the Convex token exchange
  // landing, so an account with credits and draws must not be told in it that
  // nothing has ever happened on it.
  const hasReadMovements = movements !== undefined
  const hasReadPlays = plays !== undefined
  const hasReadTickets = tickets !== undefined
  const ticketRows = tickets ?? EMPTY_TICKETS
  const pendingTicketCount = ticketRows.filter((ticket) => ticket.status === 'pending').length
  const ticketsMeta = !hasReadTickets
    ? 'Not read yet'
    : ticketRows.length === 0
      ? 'No tickets'
      : pendingTicketCount > 0
        ? `Newest ${formatCount(ticketRows.length)} · ${formatCount(pendingTicketCount)} pending`
        : `Newest ${formatCount(ticketRows.length)}`

  // What the Practice panel counts, said truthfully. The window is the newest
  // DEFAULT_PLAY_PAGE draws — which is every draw when the account holds fewer
  // — and `plays.m.record` keeps only PLAY_HISTORY_LIMIT rows per user, so the
  // ones past that are deleted rather than merely left out of these figures.
  // Party draws aggregate every player at the table into their one row.
  const practiceWindow =
    stats.plays < DEFAULT_PLAY_PAGE
      ? 'Every resolved draw on your record'
      : `Your last ${formatCount(DEFAULT_PLAY_PAGE)} resolved draws`
  const practiceDescription = `${practiceWindow}, counted at PCSO ticket prices. Draws past your most recent ${formatCount(PLAY_HISTORY_LIMIT)} are not kept. A party draw counts the tickets of every player at that table.`

  // Identity comes from Firebase first: it is there on a deployment with no
  // Convex client, and before `ensureCurrent` has written the `users` row.
  const name = user?.displayName ?? profile?.name ?? null
  const email = user?.email ?? profile?.email ?? null
  // A Google avatar is served from `lh3.googleusercontent.com`, which refuses
  // some requests outright; the refused URL is dropped so the fallback circle
  // takes over instead of the browser's broken-image glyph. The URL is kept
  // rather than a flag, so another account's photo is still tried.
  const photoUrl = user?.photoURL ?? profile?.imageUrl ?? null
  const avatarUrl = photoUrl !== null && photoUrl !== brokenPhotoUrl ? photoUrl : null
  const isVerified = user?.emailVerified === true || profile?.emailVerified === true
  const memberSince = profile?.createdAt ?? null

  // `undefined` is no answer yet, so it yields no card, exactly as an empty
  // array does: most players contact no house, and neither state is a fact to
  // print. Only a non-empty list is shown.
  const houseItems = myHouses === undefined ? [] : toMyHouseItems(myHouses)
  // A set, not one id: with two pending houses the second click must not
  // overwrite the first's busy state or have the first's `finally` clear it.
  const [confirmingHouseIds, setConfirmingHouseIds] = useState<ReadonlySet<string>>(new Set())
  const [houseError, setHouseError] = useState<string | null>(null)

  // Approved top-ups for the caller's houses. Like the houses above, no answer
  // and an empty answer both show nothing: most players front no house.
  const topupsToClaim = claimableTopups ?? []
  // One section at a time. The bankers tab exists only for someone who fronts
  // a house, and leads when a top-up is waiting, since that is what the
  // approval notification sends them here to do.
  const hasBankers = houseItems.length > 0 || topupsToClaim.length > 0
  const tabs: TabItem[] = [
    ...(hasBankers ? [{ id: 'bankers', label: topupsToClaim.length > 0 ? `Bankers (${topupsToClaim.length})` : 'Bankers' }] : []),
    { id: 'wallet', label: 'Wallet' },
    { id: 'tickets', label: 'Tickets' },
    // { id: 'practice', label: 'Practice' },
    { id: 'plays', label: 'Recent plays' },
    // { id: 'real', label: 'Real plays' }
  ]
  // Null until the reader picks one; a pick that has since disappeared (the
  // last house went away) falls back to the default as well.
  const [selectedTab, setSelectedTab] = useState<string | null>(null)
  const activeTab =
    selectedTab !== null && tabs.some((tab) => tab.id === selectedTab)
      ? selectedTab
      : topupsToClaim.length > 0
        ? 'bankers'
        : 'wallet'

  const [claimingTopupIds, setClaimingTopupIds] = useState<ReadonlySet<string>>(new Set())
  const [claimError, setClaimError] = useState<string | null>(null)

  const claimTopup = useCallback(async (id: string) => {
    setClaimingTopupIds((ids) => new Set(ids).add(id))
    setClaimError(null)
    try {
      // The list is a live query, so a claimed top-up leaves it without a refetch here.
      await convexClient?.mutation(api.money.topups.claim, { id: id as Id<'topupRequests'> })
    } catch (error) {
      const data = (error as { data?: unknown }).data
      setClaimError(
        data === 'Unauthorized.'
          ? 'That top-up cannot be claimed from this account right now. Check that the house is active.'
          : typeof data === 'string'
            ? data
            : 'Could not claim that top-up. Try again.'
      )
    } finally {
      setClaimingTopupIds((ids) => {
        const next = new Set(ids)
        next.delete(id)
        return next
      })
    }
  }, [])

  const confirmHouse = useCallback(async (accountId: string) => {
    setConfirmingHouseIds((ids) => new Set(ids).add(accountId))
    setHouseError(null)
    try {
      await convexClient?.mutation(api.accounts.m.confirmAsContact, { accountId: accountId as Id<'accounts'> })
    } catch (error) {
      // The guard refuses a stranger, an unlinked contact, a house that is no
      // longer pending and a missing house with one identical message, so the
      // server cannot say which; this sentence is true of all four.
      const data = (error as { data?: unknown }).data
      setHouseError(
        data === 'Unauthorized.'
          ? 'That house is no longer waiting on you. Reload to see its current status.'
          : 'Could not confirm that house. Try again.'
      )
    } finally {
      setConfirmingHouseIds((ids) => {
        const next = new Set(ids)
        next.delete(accountId)
        return next
      })
    }
  }, [])

  // The one load on which this user's private key exists anywhere. Everything
  // below it is about getting the key off this page and into their keeping.
  const pendingTronAccount = usePendingTronAccount()
  const [copiedTronKey, setCopiedTronKey] = useState(false)

  const copyTronKey = useCallback(async (privateKey: string) => {
    try {
      await navigator.clipboard.writeText(privateKey)
      setCopiedTronKey(true)
    } catch {
      // A refused clipboard leaves the key on screen to be selected by hand, so
      // the only thing to undo is the confirmation.
      setCopiedTronKey(false)
    }
  }, [])

  // An object URL rather than a `download` href: the key would otherwise sit in
  // the document as an attribute, and this way it is revoked the moment the file
  // is handed over.
  const downloadTronKey = useCallback((address: string, privateKey: string) => {
    const file = new Blob([`address: ${address}\nprivate key: ${privateKey}\n`], { type: 'text/plain' })
    const url = URL.createObjectURL(file)
    const link = document.createElement('a')
    link.href = url
    link.download = `tron-${address}.txt`
    link.click()
    URL.revokeObjectURL(url)
  }, [])



section(className='overview-page relative min-w-0 pt-4 [overflow-wrap:anywhere] xl:min-h-0 xl:overflow-y-auto xl:pt-10')
  div(className='pb-8 sm:px-4 xl:px-8')
    header(className='flex min-w-0 _flex-col gap-4 lg:flex-row lg:items-end justify-between')
      div(className='flex min-w-0 items-start gap-3 sm:gap-4')
        UserAvatar(avatarUrl={avatarUrl} onError={() => setBrokenPhotoUrl(photoUrl)})
        div(className='min-w-0')
          h1(className='overview-title font-sans font-medium leading-tight text-foreground portrait:text-lg! whitespace-nowrap') #{name || 'Your profile'}
          p(className='mt-1 font-mono text-xs text-muted-foreground') #{email || 'No email on this account'}
          // p(className='mt-2 text-sm text-muted-foreground') Monitor your wallet &amp; ticket activity.
      div(className='flex items-center gap-x-3 gap-y-1.5 sm:gap-x-5')
        if isVerified
          span(className={cn(chipClass, 'bg-chart-good/15 text-emerald-700 dark:text-emerald-400')}) verified
        else
          span(className={cn(chipClass, 'bg-amber-500/15 text-amber-700 dark:text-amber-400')}) unverified
        span(className='font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground portrait:hidden') joined #{formatMemberSince(memberSince)}
        // span(className='font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground') #{accountRecordLabel}

    // Signed out is either still being checked or already on its way home.
    if !isSignedIn
      div(className='mt-16 flex items-center gap-3')
        Icon(name='spinner' size={16} className='animate-spin text-muted-foreground')
        p(className='text-sm text-muted-foreground') #{isAuthLoading ? 'Checking your session…' : 'Taking you home…'}
    else
      div#profile-panel(className='overview-sections min-w-0 gap-5! pt-6! sm:gap-8! sm:pt-8!')
        // Not collapsible, and first: this is the only moment the key exists,
        // and a panel that can be folded away is one that can be missed.
        if pendingTronAccount
          Panel(title='Save your TRON key' collapsible={false} meta='shown once' className='border-amber-500/40')
            div(className='grid gap-4')
              div(className='flex items-start gap-3')
                Icon(name='alert-triangle' size={16} className='mt-0.5 shrink-0 text-amber-600 dark:text-amber-400')
                p(className='text-sm leading-relaxed text-foreground') A TRON account was created for you. Its private key is held nowhere but this page — not on our servers, not in this browser's storage. Leave or reload without saving it and the account is gone for good.
              div(className='grid gap-1')
                span(className={readingLabelClass}) address
                code(className='block min-w-0 rounded-md bg-foreground/5 px-3 py-2 font-mono text-xs text-foreground') #{pendingTronAccount.address}
              div(className='grid gap-1')
                span(className={readingLabelClass}) private key
                code(className='block min-w-0 rounded-md bg-foreground/5 px-3 py-2 font-mono text-xs text-foreground') #{pendingTronAccount.privateKey}
              div(className='flex flex-wrap items-center gap-2')
                button(
                  ~ type='button'
                  ~ onClick={() => void copyTronKey(pendingTronAccount.privateKey)}
                  ~ className='inline-flex h-11 items-center gap-2 rounded-full border border-border px-4 text-xs font-medium text-foreground sm:h-9'
                  ~ )
                  Icon(name={copiedTronKey ? 'check' : 'key'} size={14})
                  span #{copiedTronKey ? 'Copied' : 'Copy key'}
                button(
                  ~ type='button'
                  ~ onClick={() => downloadTronKey(pendingTronAccount.address, pendingTronAccount.privateKey)}
                  ~ className='inline-flex h-11 items-center gap-2 rounded-full border border-border px-4 text-xs font-medium text-foreground sm:h-9'
                  ~ )
                  Icon(name='arrow-right' size={14} className='rotate-90')
                  span Download
                // Dismissal is the reader's alone — nothing times this panel out.
                button(
                  ~ type='button'
                  ~ onClick={() => clearPendingTronAccount()}
                  ~ className='inline-flex h-11 items-center gap-2 rounded-full bg-foreground px-4 text-xs font-medium text-background sm:h-9'
                  ~ )
                  span I have saved it
        Tabs(
          ~ activeId={activeTab}
          ~ items={tabs}
          ~ onSelect={setSelectedTab}
          ~ label='Profile sections'
          ~ className='w-full min-w-0 justify-self-start gap-1 sm:w-auto sm:gap-6 [&>[data-tab]]:min-h-11 [&>[data-tab]]:min-w-0 [&>[data-tab]]:flex-1 [&>[data-tab]>span]:whitespace-normal sm:[&>[data-tab]]:flex-none'
          ~ )

        if activeTab === 'bankers'
          fragment
            if topupsToClaim.length > 0
              Panel(title='Top-ups to claim' collapsible={false} description='Approved credits waiting for you to take them into your house.' meta={formatCount(topupsToClaim.length)})
                ul(className='overview-feed')
                  each topup in topupsToClaim key topup.id
                    li(className='flex flex-wrap items-center gap-x-4 gap-y-1')
                      div(className='min-w-0 flex-1')
                        p(className='text-sm text-foreground') #{topup.amount.toLocaleString('en-US')} CR
                        p(className='text-xs text-muted-foreground') #{topup.accountName}
                      button(
                        ~ type='button'
                        ~ onClick={() => void claimTopup(topup.id)}
                        ~ disabled={claimingTopupIds.has(topup.id)}
                        ~ aria-busy={claimingTopupIds.has(topup.id) || undefined}
                        ~ className='inline-flex h-11 shrink-0 items-center rounded-full bg-foreground px-4 text-xs font-medium text-background transition-opacity disabled:opacity-60 sm:h-9'
                        ~ )
                        span #{claimingTopupIds.has(topup.id) ? 'Claiming…' : 'Claim'}
                if claimError
                  p(className='mt-4 text-xs text-destructive') #{claimError}
            if houseItems.length > 0
              Panel(title='Your Bankers' collapsible={false} description='Houses you were named on as the contact.' meta={formatCount(houseItems.length)})
                ul(className='overview-feed')
                  each house in houseItems key house.id
                    li(className='flex flex-wrap items-center gap-x-4 gap-y-1')
                      div(className='min-w-0 flex-1')
                        p(className='text-sm text-foreground') #{house.name}
                        p(className='text-xs text-muted-foreground') #{house.detail}
                      if house.canConfirm
                        button(
                          ~ type='button'
                          ~ onClick={() => void confirmHouse(house.id)}
                          ~ disabled={confirmingHouseIds.has(house.id)}
                          ~ aria-busy={confirmingHouseIds.has(house.id) || undefined}
                          ~ className='inline-flex h-11 shrink-0 items-center rounded-full bg-foreground px-4 text-xs font-medium text-background transition-opacity disabled:opacity-60 sm:h-9'
                          ~ )
                          span #{confirmingHouseIds.has(house.id) ? 'Confirming…' : 'Confirm'}
                if houseError
                  p(className='mt-4 text-xs text-destructive') #{houseError}
        elseif activeTab === 'wallet'
          fragment
            each house in houseWallets key house.accountId
              Panel(title={house.name} collapsible={false} description='Your house’s float: claimed top-ups land here.' meta={house.entries.length === 0 ? 'No movements' : `Newest ${formatCount(house.entries.length)}`})
                div(className='grid grid-cols-1 gap-5 lg:grid-cols-5 lg:gap-8')
                  div(className='grid min-w-0 content-start gap-4 lg:col-span-2 lg:gap-8')
                    StatTile(
                      ~ hero={true}
                      ~ label='House balance'
                      ~ value={house.float ? `₱${formatCredits(house.float.available)}` : '—'}
                      ~ caption={house.float ? 'Float available to hand out.' : 'This house has no float wallet yet.'}
                      ~ )
                    div(className='grid grid-cols-2 gap-3 sm:gap-6')
                      StatTile(label='Held' value={`₱${formatCredits(house.float?.held ?? 0)}`} caption='Float committed, not settled.')
                      StatTile(label='Earnings' value={`₱${formatCredits(house.earnings?.available ?? 0)}`} caption='Won from players.')
                  div(className='min-w-0 lg:col-span-3')
                    if house.entries.length === 0
                      Blank(message='This house’s float has not moved yet.')
                    else
                      WalletMovements(entries={house.entries} now={now})
            // Panel(title={houseWallets.length > 0 ? 'Your own wallet' : ''} collapsible={false} description='' meta={!hasReadMovements ? 'Not read yet' : entries.length === 0 ? 'No movements' : `Newest ${formatCount(entries.length)}`})
            div(className='grid grid-cols-1 gap-5 lg:grid-cols-5 lg:gap-8')
              div(className='grid min-w-0 content-start gap-4 lg:col-span-2 lg:gap-8')
                StatTile(
                  ~ hero={true}
                  ~ label='Balance'
                  ~ value={balanceValue}
                  ~ caption={balanceCaption}
                  ~ )
                if wallet
                  StatTile(label='Held' value={`₱${formatCredits(wallet.held)}`} caption='Committed to open plays.' className='sm:max-w-xs')
              div(className='min-w-0 lg:col-span-3')
                if entries.length === 0
                  Blank(message={hasReadMovements ? 'No credit has moved on your account yet.' : UNREAD_MOVEMENTS})
                else
                  WalletMovements(entries={entries} now={now})
        elseif activeTab === 'practice'
          Panel(
            ~ title='Practice'
            ~ collapsible={false}
            ~ description={practiceDescription}
            ~ meta={hasReadPlays ? `${formatCount(stats.plays)} draws read` : 'Not read yet'}
            ~ )
            if stats.plays === 0
              Blank(message={hasReadPlays ? 'No practice draw has been recorded on your account yet.' : UNREAD_PLAYS})
            else
              fragment
                div(className='overview-stats grid md:grid-cols-3')
                  StatTile(
                    ~ label='Draws played'
                    ~ value={formatCount(stats.plays)}
                    ~ caption={`${formatCount(stats.officialPlays)} checked against an official draw · ${formatCount(stats.simulatedPlays)} simulated.`}
                    ~ )
                  StatTile(label='Stake' value={formatPeso(stats.spent)} caption='What those tickets would have cost.')
                  StatTile(label='Winnings' value={formatPeso(stats.won)} caption='What those tickets would have paid, official and simulated draws together.')
                  StatTile(
                    ~ label='Net'
                    ~ value={formatNet(stats.net)}
                    ~ caption={stats.net < 0 ? 'Down across the draws counted here.' : 'Up across the draws counted here.'}
                    ~ )
                  StatTile(label='Win rate' value={formatPercent(stats.winRate, 1)} caption='Winning tickets over the tickets of those draws.')
                  if bestDraw
                    StatTile(
                      ~ label='Best draw'
                      ~ value={formatPeso(bestDraw.won)}
                      ~ caption={`${GAMES[bestDraw.game].name} · ${formatRelativeTime(bestDraw.drawnAt, now)}.`}
                      ~ )
                if stats.officialPlays > 0
                  // A PCSO check asks what own numbers would have done in the real
                  // draw. Pooled into totals dominated by generator fiction that
                  // answer is lost, so it is named once rather than doubling every tile.
                  p(className='mt-8 text-xs text-muted-foreground') #{`Of which official: ${formatPeso(stats.officialSpent)} staked and ${formatPeso(stats.officialWon)} paid across ${formatCount(stats.officialPlays)} checked draws, on ${formatCount(stats.officialWinCount)} winning tickets.`}
                if favouriteGame
                  p(className='mt-4 text-xs text-muted-foreground') #{`Most played: ${GAMES[favouriteGame].name}.`}
                div(className='mt-10')
                  Distribution(
                    ~ segments={stats.hitDistribution}
                    ~ caption={`Tickets by numbers matched. Counted from the ticket detail each draw stores — at most ${formatCount(TICKET_DETAIL_LIMIT)} tickets of a draw — so a larger draw is represented by those rather than by every ticket it held.`}
                    ~ )

        elseif activeTab === 'tickets'
          // Panel(title='Tickets' collapsible={false} description='Tickets you bought with credits, newest first. 1 credit is worth ₱1.' meta={ticketsMeta})
          div
            if ticketRows.length === 0
              Blank(message={hasReadTickets ? 'You have not bought a ticket yet.' : UNREAD_TICKETS})
            else
              fragment
                div(aria-hidden='true' className={cn('hidden items-center gap-x-3 pb-2 xl:grid', ticketColumns)})
                  span(className={readingLabelClass}) Game
                  span(className={readingLabelClass}) Numbers
                  span(className={readingLabelClass}) Status
                  span(className={readingLabelClass}) Draw
                  span(className={cn(readingLabelClass, 'text-right')}) Stake
                  span(className={cn(readingLabelClass, 'text-right')}) Payout
                  span(className={cn(readingLabelClass, 'text-right')}) Bought
                ul(className='overview-feed')
                  each ticket in ticketRows key ticket.ticketId
                    li(className={cn('grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3', ticketColumns)})
                      p(className='col-start-1 row-start-1 min-w-0 text-sm font-medium text-foreground xl:col-auto xl:row-auto') #{GAMES[ticket.game].name}
                      div(role='group' aria-label='Ticket numbers' className='col-span-2 row-start-2 flex min-w-0 flex-wrap gap-2 xl:col-span-1 xl:row-auto')
                        each n in ticket.numbers key n
                          span(className='grid size-8 shrink-0 place-items-center rounded-full bg-foreground text-sm font-medium text-background xl:size-9 xl:text-base') #{n}
                      span(className={cn(chipClass, TICKET_STATUS_TONE[ticket.status], 'col-start-2 row-start-1 justify-self-end xl:col-auto xl:row-auto xl:justify-self-start')}) #{ticket.status}
                      dl(className='col-span-2 row-start-3 grid grid-cols-2 gap-x-3 gap-y-2 xl:contents')
                        TicketReading(label='Draw' value={formatDraw(ticket.drawDate, ticket.drawTime)} className='font-mono text-muted-foreground whitespace-nowrap')
                        TicketReading(label='Stake' value={`₱${formatCredits(ticket.cost)}`} className='text-right text-foreground')
                        TicketReading(label='Payout' value={`₱${formatCredits(ticket.cost * 360)}`} className='text-muted-foreground xl:text-right')
                        TicketReading(label='Bought' value={formatRelativeTime(ticket.createdAt, now)} className='text-right font-mono text-muted-foreground whitespace-nowrap')
        elseif activeTab === 'plays'
          Panel(title='Recent plays' collapsible={false} description='One row per resolved draw, newest first.' meta={!hasReadPlays ? 'Not read yet' : rows.length === 0 ? 'No draws' : `${formatCount(playFeed.length)} of ${formatCount(rows.length)}`})
            if playFeed.length === 0
              Blank(message={hasReadPlays ? 'Resolve a draw while signed in and it is listed here.' : UNREAD_PLAYS})
            else
              ul(className='overview-feed')
                each play in playFeed key play._id
                  li(className='grid min-w-0 grid-cols-2 items-center gap-x-3 gap-y-2 lg:flex lg:gap-4')
                    div(className='col-span-2 min-w-0 lg:flex-1')
                      div(className='flex flex-wrap items-center gap-x-2 gap-y-1')
                        p(className='text-sm font-medium text-foreground') #{GAMES[play.game].name}
                        if play.isOfficial
                          span(className={cn(chipClass, 'bg-foreground/5 text-muted-foreground')}) official
                        if play.mode === 'party'
                          span(className={cn(chipClass, 'bg-foreground/5 text-muted-foreground')}) party
                      p(className='mt-1 font-mono text-xs text-muted-foreground') #{formatDrawnBalls(play.drawnBalls)}
                    span(className='font-mono text-xs tabular-nums text-muted-foreground lg:min-w-24 lg:text-right') #{`${formatCount(play.ticketCount)} tickets`}
                    span(className='text-right font-mono text-xs tabular-nums text-muted-foreground lg:min-w-16') #{formatHits(play.bestHits)}
                    span(className={cn('font-mono text-sm tabular-nums lg:min-w-24 lg:text-right', play.won > 0 ? POSITIVE_TONE : 'text-muted-foreground/70')}) #{formatPeso(play.won)}
                    span(className='text-right font-mono text-2xs tabular-nums text-muted-foreground/70 lg:min-w-20') #{formatRelativeTime(play.drawnAt, now)}
        else
          Panel(title='Real plays' collapsible={false} description='Tickets bought with credits, once they can be bought.' meta='Not yet playable')
            Blank(message='Credit-backed tickets are still being built. When they ship, every ticket you buy with credits is listed here with the draw it was entered in and what it settled for.')
