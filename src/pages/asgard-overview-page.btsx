import { useCallback, useEffect, useState } from 'octane'
import { Masthead, Meter, Panel, StatTile } from '@/components/overview'
import { Icon } from '@/lib/icons'
import { isAbortError, readErrorMessage } from '@/lib/asgard/errors'
import { fetchOverview, houseNet, type AsgardOverview } from '@/lib/asgard/overview'
import { formatCount, formatTime } from '@/lib/overview/metrics'
import { formatDraw } from '@/lib/tickets/format'
import { cn } from '@/lib/utils'

module
  /**
   * The console's overview: the business, account by account. What each has
   * sold and paid out lately, and what it has riding on the draws coming up.
   */
  const headClass = 'font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground'
  const numClass = 'font-sans font-[450] text-sm tabular-nums'
  const blankClass = 'rounded-lg border border-dashed border-border/60 px-4 py-10 text-center text-sm text-muted-foreground'
  const chipClass = 'rounded-xs px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider'

  const formatCredits = (value: number) => `${value.toLocaleString('en-US')} CR`
  const formatSigned = (value: number) => `${value > 0 ? '+' : value < 0 ? '−' : ''}${Math.abs(value).toLocaleString('en-US')} CR`
  const netTone = (value: number) =>
    value > 0 ? 'text-emerald-700 dark:text-emerald-400' : value < 0 ? 'text-destructive' : 'text-muted-foreground'
  // A `+` marks a figure that stopped counting at the read cap.
  const plus = (partial: boolean) => (partial ? '+' : '')

  const STATUS_TONE: Record<string, string> = {
    active: 'bg-chart-good/15 text-emerald-700 dark:text-emerald-400',
    suspended: 'bg-destructive/10 text-destructive'
  }
  const statusTone = (status: string) => STATUS_TONE[status] ?? 'bg-amber-500/15 text-amber-700 dark:text-amber-400'

setup
  const [overview, setOverview] = useState<AsgardOverview | null>(null)
  const [error, setError] = useState<string | null>(null)
  const [isLoading, setIsLoading] = useState(true)
  const [reloadToken, setReloadToken] = useState(0)
  const refresh = useCallback(() => setReloadToken((token) => token + 1), [])

  useEffect(() => {
    const controller = new AbortController()
    setIsLoading(true)
    fetchOverview(controller.signal)
      .then((body) => {
        setOverview(body)
        setError(null)
        setIsLoading(false)
      })
      .catch((reason: unknown) => {
        if (isAbortError(reason)) return
        setError(readErrorMessage(reason, 'Could not load the overview.'))
        setIsLoading(false)
      })
    return () => controller.abort()
  }, [reloadToken])

  const totals = overview?.totals
  const settled = totals ? totals.won + totals.lost : 0
  const openSales = overview ? overview.upcoming.reduce((sum, draw) => sum + draw.sales, 0) : 0
  const openTickets = overview ? overview.upcoming.reduce((sum, draw) => sum + draw.tickets, 0) : 0
  const freshness = overview === null ? 'loading' : error ? 'stale' : formatTime(overview.readAt)

section(className='relative overview-page px-4 pb-16 md:px-6')
  div(className='overview-content')
    Masthead(
      ~ eyebrow='Asgard · Control'
      ~ title='Overview'
      ~ description='What every account is selling, what it has paid out, and what is riding on the next draws.'
      ~ )
      div(className='flex items-center gap-2 rounded-full border border-border/50 px-3 py-1.5')
        span(aria-hidden={true} className={cn('size-1.5 rounded-full', error ? 'bg-chart-warn' : 'bg-chart-good')})
        span(className='font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground') #{freshness}
      button(
        ~ type='button'
        ~ onClick={refresh}
        ~ disabled={isLoading}
        ~ aria-label='Refresh'
        ~ className='group inline-flex size-8 items-center justify-center rounded-full border border-border/50 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground disabled:opacity-50'
        ~ )
        Icon(name={isLoading ? 'spinner' : 'refresh'} size={14} className={cn(isLoading ? 'animate-spin' : 'transition-transform duration-300 ease-out group-active:rotate-180')})

    if overview === null && isLoading
      div(className='mt-16 flex items-center gap-3')
        Icon(name='spinner' size={16} className='animate-spin text-muted-foreground')
        p(className='text-sm text-muted-foreground') Reading account sales…
    elseif overview === null
      p(className={cn(blankClass, 'mt-10')}) #{error}
    else
      div(className='overview-sections')
        if error
          div(className='flex items-start gap-2.5 rounded-lg border border-chart-warn/30 bg-chart-warn/5 px-4 py-3')
            Icon(name='alert-triangle' size={14} className='mt-0.5 shrink-0 text-amber-700 dark:text-amber-400')
            p(className='text-xs text-muted-foreground') #{`Showing the last figures read. ${error}`}

        div(className='overview-stats grid sm:grid-cols-2 lg:grid-cols-4')
          StatTile(
            ~ label='Ticket sales'
            ~ value={formatCredits(totals!.sales)}
            ~ caption={`${formatCount(totals!.tickets)} tickets in the last ${overview.windowDays} days`}
            ~ )
          StatTile(
            ~ label='Prizes paid'
            ~ value={formatCredits(totals!.payout)}
            ~ caption={`${formatCount(totals!.won)} winning tickets`}
            ~ )
          StatTile(
            ~ label='House net'
            ~ value={formatSigned(houseNet(totals!))}
            ~ caption='Sales less prizes, every account together'
            ~ )
          StatTile(
            ~ label='Open bets'
            ~ value={formatCredits(openSales)}
            ~ caption={`${formatCount(openTickets)} tickets on the upcoming draws`}
            ~ )

        Panel(title='Upcoming draws' description='The next draw of every game on sale, and what each account has sold into it so far.' collapsible={false} meta={`${formatCount(overview.upcoming.length)} ${overview.upcoming.length === 1 ? 'draw' : 'draws'}`})
          if overview.upcoming.length === 0
            p(className={blankClass}) No game is on sale, so no draw is coming up.
          else
            fragment
              div(className='flex items-center gap-x-4 pb-2')
                span(className={cn(headClass, 'min-w-0 flex-1')}) Game
                span(className={cn(headClass, 'hidden w-44 shrink-0 sm:inline')}) Draw
                span(className={cn(headClass, 'w-20 shrink-0 text-right')}) Tickets
                span(className={cn(headClass, 'w-28 shrink-0 text-right')}) Sales
              ul(className='overview-feed')
                each draw in overview.upcoming key draw.game
                  li(className='space-y-2')
                    div(className='flex items-center gap-x-4')
                      div(className='min-w-0 flex-1')
                        p(className='truncate font-sans font-[450] text-base text-foreground') #{draw.name}
                        p(className='truncate font-mono text-xs text-muted-foreground sm:hidden') #{formatDraw(draw.drawDate, draw.drawTime)}
                      p(className='hidden w-44 shrink-0 truncate font-mono text-sm text-muted-foreground sm:block') #{formatDraw(draw.drawDate, draw.drawTime)}
                      span(className={cn('w-20 shrink-0 text-right', numClass, draw.tickets > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCount(draw.tickets)}#{plus(draw.partial)}
                      span(className={cn('w-28 shrink-0 text-right', numClass, draw.sales > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCredits(draw.sales)}#{plus(draw.partial)}
                    if draw.byAccount.length > 0
                      ul(className='space-y-1 border-l border-dotted border-border/60 pl-3')
                        each share in draw.byAccount key share.accountId
                          li(className='flex items-center gap-x-4')
                            // The share bar stays inside the name column so the
                            // figures line up under the draw's own.
                            div(className='flex min-w-0 flex-1 items-center gap-3')
                              span(className='min-w-0 truncate text-sm text-muted-foreground') #{share.name}
                              // Each account's share of this draw's sales, as a bar.
                              Meter(value={draw.sales === 0 ? 0 : share.sales / draw.sales} color='var(--chart-info)' aria-label={`${share.name}'s share of this draw's sales`} className='hidden w-20 shrink-0 md:block')
                            span(className='hidden w-44 shrink-0 sm:block')
                            span(className={cn('w-20 shrink-0 text-right text-muted-foreground', numClass)}) #{formatCount(share.tickets)}
                            span(className={cn('w-28 shrink-0 text-right text-muted-foreground', numClass)}) #{formatCredits(share.sales)}

        Panel(title='Accounts' description={`Tickets sold over the last ${overview.windowDays} days, how they came out, and what is open on the next draws.`} collapsible={false} meta={`${formatCount(overview.accounts.length)} ${overview.accounts.length === 1 ? 'account' : 'accounts'}`})
          if overview.accounts.length === 0
            p(className={blankClass}) No account has been created yet.
          else
            fragment
              // Each header cell repeats the width and breakpoint of the cell
              // below it, so the two must change together.
              div(className='flex items-center gap-x-4 pb-2')
                span(className={cn(headClass, 'min-w-0 flex-1')}) Account
                span(className={cn(headClass, 'hidden w-20 shrink-0 text-right md:inline')}) Tickets
                span(className={cn(headClass, 'w-28 shrink-0 text-right')}) Sales
                span(className={cn(headClass, 'hidden w-36 shrink-0 lg:inline')}) Won · Lost · Open
                span(className={cn(headClass, 'hidden w-28 shrink-0 text-right sm:inline')}) Payouts
                span(className={cn(headClass, 'w-28 shrink-0 text-right')}) Net
                span(className={cn(headClass, 'hidden w-28 shrink-0 text-right xl:inline')}) Next draws
              ul(className='overview-feed')
                each account in overview.accounts key account.accountId
                  li(className='flex items-center gap-x-4')
                    div(className='min-w-0 flex-1')
                      p(className='truncate font-sans font-[450] text-base text-foreground' title={account.name}) #{account.name}
                      div(className='flex min-w-0 items-center gap-2')
                        p(className='min-w-0 truncate font-mono text-xs text-muted-foreground') #{account.slug}
                        if account.status !== 'active'
                          span(className={cn(chipClass, 'shrink-0', statusTone(account.status))}) #{account.status}
                    span(className={cn('hidden w-20 shrink-0 text-right md:inline', numClass, account.tickets > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCount(account.tickets)}#{plus(account.partial)}
                    span(className={cn('w-28 shrink-0 text-right', numClass, account.sales > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCredits(account.sales)}#{plus(account.partial)}
                    div(className='hidden w-36 shrink-0 lg:block')
                      p(className='font-mono text-xs tabular-nums text-muted-foreground')
                        span(className={account.won > 0 ? 'text-emerald-700 dark:text-emerald-400' : undefined}) #{formatCount(account.won)}
                        | #{' · '}#{formatCount(account.lost)}#{' · '}#{formatCount(account.pending)}
                      // Settled tickets that won, out of all settled.
                      Meter(value={account.won + account.lost === 0 ? 0 : account.won / (account.won + account.lost)} color='var(--chart-good)' aria-label={`Share of ${account.name}'s settled tickets that won`} className='mt-1')
                    span(className={cn('hidden w-28 shrink-0 text-right sm:inline', numClass, account.payout > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCredits(account.payout)}
                    span(className={cn('w-28 shrink-0 text-right font-mono text-sm tabular-nums', netTone(houseNet(account)))}) #{formatSigned(houseNet(account))}
                    span(className={cn('hidden w-28 shrink-0 text-right xl:inline', numClass, account.upcoming.sales > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCredits(account.upcoming.sales)}
              p(className='pt-3 text-xs text-muted-foreground') #{`${formatCount(settled)} of ${formatCount(totals!.tickets)} tickets in the window have settled. Net is sales less prizes; a ticket still open counts its sale but no prize yet.`}

    div(aria-hidden={true} className='h-20 w-full')
