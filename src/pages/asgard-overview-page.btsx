import { AreaChart, Distribution, Masthead, Meter, Panel, StatTile } from '@/components/overview'
import { useAsgardSummary } from '@/hooks/use-asgard-summary'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { getGodUserLabel } from '@/lib/asgard/gods-users'
import { COMPARISON_DAYS, GROWTH_DAYS, readGovernance, readIntegrity, readLedger } from '@/lib/asgard/asgard-overview'
import { formatCount, formatPercent, formatRelativeTime, formatTime, percentDelta, toTimestamp } from '@/lib/overview/metrics'

module
  const EMPTY_DATASETS = [] as const
  const EMPTY_ISSUES = [] as const
  const EMPTY_ROSTER = [] as const

  const ROSTER_PREVIEW_LIMIT = 5
  const FILE_LIMIT = 6

  const readingLabelClass = 'font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground'
  const claimChipClass = 'rounded-xs px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider'

  const pesoFormatter = new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 })

  /** A draw date is an ISO day, not a timestamp — it is shown as the day it is. */
  const formatDrawDate = (date: string | null) => date ?? '—'

  // A near-miss rate must not round to a flat 100% beside a caption that counts
  // the exceptions, so a rate keeps digits until it stops reading as complete.
  // Only a true 100% is written as one.
  const formatRate = (value: number) => formatPercent(value, value === 1 ? 0 : value > 0.999 ? 3 : 1)

setup
  const { datasets, issues, roster, error, isLoading, lastUpdatedAt, refresh } = useAsgardSummary()

  const now = Date.now()
  const ledger = readLedger(datasets ?? EMPTY_DATASETS, now)
  const integrity = readIntegrity(issues ?? EMPTY_ISSUES)
  const governance = readGovernance(roster?.users ?? EMPTY_ROSTER, roster?.scanned ?? 0, roster?.truncated ?? false)

  const growthDelta = percentDelta(ledger.totals)
  const rosterPreview = governance.recent.slice(0, ROSTER_PREVIEW_LIMIT)
  const files = integrity.files.slice(0, FILE_LIMIT)

  const hasRows = datasets !== undefined || roster !== undefined
  const isPreparing = isLoading && !hasRows
  const freshnessLabel = lastUpdatedAt === null ? 'syncing' : formatTime(lastUpdatedAt)

// Asgard scrolls as one page: the console is the whole site on this host, so
// there is no fixed shell to clip the overview into.
section(className='relative overview-page px-4 pb-16 md:px-6')
  div(className='overview-content')
    Masthead(
      ~ eyebrow='Asgard · Control'
      ~ title='Overview'
      ~ description='Every official draw the app is built on, and everyone holding the keys to it.'
      ~ )
      div(className='flex items-center gap-2 rounded-full border border-border/50 px-3 py-1.5')
        span(aria-hidden={true} className={cn('size-1.5 rounded-full', error ? 'bg-chart-warn' : 'bg-chart-good')})
        span(className='font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground') #{error ? 'stale' : freshnessLabel}
      button(
        ~ type='button'
        ~ onClick={refresh}
        ~ aria-label='Refresh'
        ~ className='group inline-flex size-8 items-center justify-center rounded-full border border-border/50 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground'
        ~ )
        Icon(name='refresh' size={14} className='transition-transform duration-300 ease-out group-active:rotate-180')

    if isPreparing
      div(className='mt-16 flex items-center gap-3')
        Icon(name='spinner' size={16} className='animate-spin text-muted-foreground')
        p(className='text-sm text-muted-foreground') Reading the draw ledger…
    else
      div(className='overview-sections')
        if error
          div(className='flex items-start gap-2.5 rounded-lg border border-chart-warn/30 bg-chart-warn/5 px-4 py-3')
            Icon(name='alert-triangle' size={14} className='mt-0.5 shrink-0 text-amber-700 dark:text-amber-400')
            p(className='text-xs text-muted-foreground') #{error}

        Panel(title='Book of draws' description='Official results on record, counted cumulatively.' meta={`Last ${GROWTH_DAYS} days`})
          div(className='grid gap-10 lg:grid-cols-5 lg:gap-8')
            div(className='lg:col-span-2')
              p(className={readingLabelClass}) Draws on record
              div(className='mt-3 flex items-end gap-3')
                span(className='font-sans text-5xl font-medium leading-none tracking-tight text-foreground') #{formatCount(ledger.total)}
                if growthDelta !== null
                  span(className={cn('mb-1 inline-flex items-center gap-1 font-mono text-xs', growthDelta >= 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-destructive')})
                    span(aria-hidden={true}) #{growthDelta >= 0 ? '↑' : '↓'}
                    span #{`${growthDelta >= 0 ? '+' : ''}${Math.round(growthDelta * 100)}%`}
              p(className='mt-2 text-xs text-muted-foreground') #{`${formatCount(ledger.totals.current)} drawn in the last ${COMPARISON_DAYS} days · vs prior ${COMPARISON_DAYS} days`}
              dl(className='mt-8 space-y-3 border-t border-dotted border-border/60 pt-5')
                div(className='flex items-baseline justify-between gap-4')
                  dt(className='text-xs text-muted-foreground') Games on record
                  dd(className='font-mono text-sm tabular-nums text-foreground') #{formatCount(ledger.games.length)}
                div(className='flex items-baseline justify-between gap-4')
                  dt(className='text-xs text-muted-foreground') Oldest draw
                  dd(className='font-mono text-sm tabular-nums text-foreground') #{formatDrawDate(ledger.firstDate)}
                div(className='flex items-baseline justify-between gap-4')
                  dt(className='text-xs text-muted-foreground') Newest draw
                  dd(className='font-mono text-sm tabular-nums text-foreground') #{formatDrawDate(ledger.lastDate)}
                div(className='flex items-baseline justify-between gap-4')
                  dt(className='text-xs text-muted-foreground') Directory records scanned
                  dd(className='font-mono text-sm tabular-nums text-foreground') #{governance.scanned === 0 ? '—' : formatCount(governance.scanned)}
            div(className='lg:col-span-3')
              AreaChart(buckets={ledger.growth} unit='draws' color='var(--chart-info)')

        div(className='overview-stats grid md:grid-cols-3')
          StatTile(
            ~ label='Import coverage'
            ~ value={ledger.total === 0 ? '—' : formatRate(ledger.coverage)}
            ~ caption={ledger.total === 0 ? 'No draw files have been generated yet.' : `${formatCount(ledger.excluded)} source rows were refused on the way in.`}
            ~ )
            Meter(value={ledger.coverage} color='var(--chart-good)' aria-label='Share of source rows that were imported' className='mb-3')
          StatTile(
            ~ label='Draws with a number set'
            ~ value={ledger.total === 0 ? '—' : formatRate(ledger.completeRate)}
            ~ caption={ledger.total === 0 ? 'Completeness appears once draws exist.' : `${formatCount(ledger.incomplete)} draws carry no usable numbers.`}
            ~ )
            Meter(value={ledger.completeRate} color='var(--tier-3)' aria-label='Share of draws carrying a number set' className='mb-3')
          StatTile(
            ~ label='Privileged operators'
            ~ value={formatCount(governance.gods)}
            ~ caption={`${formatCount(governance.topGods)} of them can grant the claim to someone else.`}
            ~ )
            if governance.unverified > 0
              p(className='mb-3 inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.14em] text-amber-700 dark:text-amber-400')
                Icon(name='alert-triangle' size={11})
                span #{`${formatCount(governance.unverified)} unverified`}

        div(className='grid items-start gap-10 lg:grid-cols-2')
          Panel(title='Draw mix' description='Which games the ledger is made of.' meta={`${formatCount(ledger.total)} draws`})
            Distribution(segments={ledger.gameSegments} caption='One hue, stepped light to dark as the number pool grows: the shade is the pool, not an identity.')
          Panel(title='Prize pool' description='What those draws carried, and how often they were won.' meta='All time')
            div(className='space-y-5')
              div(className='flex items-baseline justify-between gap-4')
                span(className={readingLabelClass}) Jackpots on record
                span(className='font-sans text-2xl font-medium tabular-nums tracking-tight text-foreground') #{`₱${pesoFormatter.format(ledger.jackpotPesos)}`}
              div
                div(className='flex items-baseline justify-between gap-4')
                  span(className={readingLabelClass}) Draws with a winner
                  span(className='font-mono text-sm tabular-nums text-foreground') #{`${formatCount(ledger.wonDraws)} · ${formatPercent(ledger.wonRate)}`}
                Meter(value={ledger.wonRate} color='var(--chart-good)' aria-label='Share of draws that reported a winner' className='mt-3')
              p(className='text-xs text-muted-foreground') A draw with no reported winner rolls its pool into the next one, so the two readings are not a ratio of money paid out.

        Panel(title='Ledger by game' description='Every game file, newest draw first on record.' meta={`${formatCount(ledger.games.length)} files`})
          if ledger.games.length === 0
            p(className='text-sm text-muted-foreground') No draw files have been generated yet.
          else
            ul(className='overview-feed')
              each game in ledger.games key game.id
                li(className='flex flex-wrap items-center gap-x-4 gap-y-1')
                  div(className='min-w-0 flex-1')
                    p(className='truncate text-sm text-foreground') #{game.label}
                    p(className='truncate font-mono text-xs text-muted-foreground') #{`last drawn ${formatDrawDate(game.lastDate)}`}
                  span(className='w-24 shrink-0 text-right font-mono text-xs tabular-nums text-muted-foreground') #{`${formatCount(game.draws)} draws`}
                  span(className={cn('w-24 shrink-0 text-right font-mono text-2xs uppercase tracking-wider', game.excluded > 0 ? 'text-amber-700 dark:text-amber-400' : 'text-muted-foreground/70')}) #{game.excluded === 0 ? 'clean' : `${formatCount(game.excluded)} refused`}

        Panel(title='Import report' description='What the results build refused, by source file.' meta={integrity.issues === 0 ? 'No findings' : `${formatCount(integrity.issues)} findings`})
          if files.length === 0
            p(className='text-sm text-muted-foreground') #{error ? 'The import report could not be read on this load.' : 'The last results build found nothing to report.'}
          else
            ul(className='overview-feed')
              each file in files key file.file
                li(className='flex flex-wrap items-center gap-x-4 gap-y-1')
                  div(className='min-w-0 flex-1')
                    p(className='truncate font-mono text-sm text-foreground') #{file.file}
                  span(className='w-28 shrink-0 text-right font-mono text-xs tabular-nums text-muted-foreground') #{`${formatCount(file.issues)} findings`}

        Panel(title='Keys to the platform' description='Everyone holding the god claim, most recently seen first.' meta={governance.truncated ? 'Roster capped' : `${formatCount(governance.gods)} operators`})
          if rosterPreview.length === 0
            p(className='text-sm text-muted-foreground') #{error ? 'The roster could not be read on this load.' : 'No one holds the god claim.'}
          else
            ul(className='overview-feed')
              each user in rosterPreview key user.uid
                li(className='flex flex-wrap items-center gap-x-3 gap-y-1')
                  div(className='min-w-0 flex-1')
                    p(className='truncate text-sm text-foreground') #{getGodUserLabel(user)}
                    p(className='truncate font-mono text-xs text-muted-foreground') #{user.email ?? user.uid}
                  if user.topg
                    span(className={cn(claimChipClass, 'bg-active/10 text-active')}) top god
                  if user.disabled
                    span(className={cn(claimChipClass, 'bg-destructive/10 text-destructive')}) disabled
                  if !user.emailVerified
                    span(className={cn(claimChipClass, 'bg-amber-500/15 text-amber-700 dark:text-amber-400')}) unverified
                  span(className='w-24 shrink-0 text-right font-mono text-2xs tabular-nums text-muted-foreground/70') #{toTimestamp(user.lastSignInAt) === null ? 'never' : formatRelativeTime(toTimestamp(user.lastSignInAt) ?? now, now)}

    div(aria-hidden={true} className='h-20 w-full')
