import { Masthead, Panel } from '@/components/overview'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { GAMES } from '@/lib/games'
import { Icon } from '@/lib/icons'
import { formatCount } from '@/lib/overview/metrics'
import { formatDraw } from '@/lib/tickets/format'
import { cn } from '@/lib/utils'
import type { FunctionReturnType } from 'convex/server'
import { api } from '../../convex/_generated/api'

module
  type DrawResult = FunctionReturnType<typeof api.tickets.q.recentResults>[number]

  const blankClass = 'rounded-lg border border-dashed border-border/60 px-4 py-10 text-center text-sm text-muted-foreground'
  const headClass = 'font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground'
  const chipClass = 'rounded-xs px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider'

  // A draw's state is carried by the word, with colour only as a second cue.
  const STATUS_TONE: Record<DrawResult['status'], string> = {
    pending: 'bg-amber-500/15 text-amber-700 dark:text-amber-400',
    settled: 'bg-chart-good/15 text-emerald-700 dark:text-emerald-400',
    none: 'bg-foreground/5 text-muted-foreground'
  }
  const STATUS_LABEL: Record<DrawResult['status'], string> = {
    pending: 'pending',
    settled: 'settled',
    none: 'no tickets'
  }

  const formatCredits = (value: number) => `${value.toLocaleString('en-US')} CR`
  // Ascending, the way a result is read out, whatever order it was stored in.
  const formatNumbers = (numbers: readonly number[] | null) =>
    numbers === null ? '—' : [...numbers].sort((a, b) => a - b).join(' · ')

  // A result stores its hour as PCSO prints it (`9PM`); the shared formatter
  // reads `HH:mm`. An imported result may carry no hour at all.
  const DRAW_TIMES: Record<string, string> = { '2PM': '14:00', '5PM': '17:00', '9PM': '21:00' }
  const formatResultDraw = (result: DrawResult) => formatDraw(result.date, result.time === null ? null : DRAW_TIMES[result.time] ?? null)

setup
  const { user, isLoading } = useFirebaseUser()
  const isSignedIn = user !== null
  // The results are public; the ticket figures beside each one are the
  // caller's own houses', derived from their identity on the server.
  const results = useConvexQuery(api.tickets.q.recentResults, {}, { enabled: isSignedIn })

section(className='relative overview-page px-4 pb-16 md:px-6')
  div(className='overview-content')
    Masthead(
      ~ title='Results'
      ~ description=''
      ~ )

    div(className='overview-sections')
      if !isSignedIn
        p(className={blankClass}) #{isLoading ? 'Checking your session…' : 'Sign in as a banker to see draw results.'}
      elseif results === undefined
        div(className='flex items-center gap-3 py-10')
          Icon(name='spinner' size={16} className='animate-spin text-muted-foreground')
          p(className='text-sm text-muted-foreground') Reading draw results…
      else
        Panel(
          ~ title='Recent draws'
          ~ collapsible={false}
          ~ meta={`${formatCount(results.length)} ${results.length === 1 ? 'result' : 'results'}`}
          ~ )
          if results.length === 0
            p(className={blankClass}) No draw result has been imported yet.
          else
            fragment
              // Each header cell repeats the width and breakpoint of the cell
              // below it, so the two must change together.
              div(className='flex items-center gap-x-4 pb-2')
                span(className={cn(headClass, 'min-w-0 flex-1')}) Result numbers
                span(className={cn(headClass, 'hidden w-24 shrink-0 lg:inline')}) Game
                span(className={cn(headClass, 'hidden w-44 shrink-0 md:inline')}) Draw Date
                span(className={cn(headClass, 'w-20 shrink-0 text-right')}) Winners
                span(className={cn(headClass, 'hidden w-44 shrink-0 md:inline')}) Numbers
                span(className={cn(headClass, 'hidden w-24 shrink-0 text-right xl:inline')}) Tickets sold
                span(className={cn(headClass, 'hidden w-28 shrink-0 text-right lg:inline')}) Sales
                span(className={cn(headClass, 'hidden w-28 shrink-0 text-right sm:inline')}) Payout
                span(className={cn(headClass, 'w-28 shrink-0 text-right')}) Status
              ul(className='overview-feed')
                each result in results key result.drawId
                  li(className='flex items-center gap-x-4')
                    span(className='min-w-0 flex-1 truncate font-sans font-[450] text-base tabular-nums text-foreground') #{formatNumbers(result.numbers)}
                    div(className='hidden w-24 min-w-0 shrink-0 lg:block')
                      p(className='truncate text-sm text-muted-foreground') #{GAMES[result.game].name}
                    div(className='hidden w-44 min-w-0 shrink-0 md:block')
                      p(className='truncate font-mono text-sm text-muted-foreground') #{formatResultDraw(result)}
                    // A `+` marks a draw with more tickets than were counted.
                    span(className={cn('w-20 shrink-0 text-right font-sans font-[450] text-sm tabular-nums', result.winners > 0 ? 'text-foreground' : 'text-muted-foreground')}) #{formatCount(result.winners)}#{result.partial ? '+' : ''}
                    // The numbers a winning player held. One ticket per line; a
                    // draw with more winners than are carried says how many more.
                    div(className='hidden w-44 min-w-0 shrink-0 md:block')
                      if result.winningNumbers.length === 0
                        p(className='text-sm text-muted-foreground') —
                      else
                        fragment
                          each numbers, index in result.winningNumbers key index
                            p(className='truncate font-sans font-[450] text-sm tabular-nums text-foreground') #{formatNumbers(numbers)}
                          if result.winners > result.winningNumbers.length
                            p(className='font-mono text-2xs text-muted-foreground') +#{formatCount(result.winners - result.winningNumbers.length)} more
                    span(className='hidden w-24 shrink-0 text-right font-sans font-[450] text-sm tabular-nums text-muted-foreground xl:inline') #{formatCount(result.tickets)}#{result.partial ? '+' : ''}
                    span(className='hidden w-28 shrink-0 text-right font-sans font-[450] text-sm tabular-nums text-muted-foreground lg:inline') #{formatCredits(result.sales)}#{result.partial ? '+' : ''}
                    span(className={cn('hidden w-28 shrink-0 text-right font-mono text-sm tabular-nums sm:inline', result.payout > 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-muted-foreground')}) #{formatCredits(result.payout)}#{result.partial ? '+' : ''}
                    div(className='w-28 shrink-0 text-right')
                      span(className={cn(chipClass, STATUS_TONE[result.status])}) #{STATUS_LABEL[result.status]}

    div(aria-hidden={true} className='h-20 w-full')
