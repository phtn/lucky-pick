import { useCallback, useState } from 'octane'
import { Outlet, useRouterState } from '@octanejs/tanstack-router'
import { Group, Panel, Separator, usePanelRef, type PanelSize } from '@octanejs/resizable-panels'
import { Sidebar, ThemeToggle } from '@/components/admin'
import type { AdminNavItem } from '@/components/admin'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { readAdminGate } from '@/lib/admin/access'
import { convexClient } from '@/lib/convex-client'
import { isFirebaseConfigured } from '@/lib/firebase'
import { describeAuthError, signInWithGoogle, useFirebaseUser } from '@/lib/firebase/auth'
import { Icon } from '@/lib/icons'
import { adminRoutePrefix, isAdminSubdomainHostname } from '@/lib/routing/admin-subdomain'
import { buildAppUrl } from '@/lib/routing/app-url'
import { api } from '../../convex/_generated/api'

module
  /**
   * The console's pages, in nav order.
   *
   * Their paths are relative to wherever the console is mounted: its own
   * subdomain roots them at `/`, while the main origin roots them under
   * `/admin`, so the links have to be built rather than written out.
   */
  const navPages: AdminNavItem[] = [
    { to: '', label: 'Overview', icon: 'chart', exact: true },
    { to: '/players', label: 'Players', icon: 'person' },
    { to: '/tickets', label: 'Tickets', icon: 'ticket' },
    { to: '/results', label: 'Results', icon: 'trophy' }
  ]

  const toNavItems = (base: string): AdminNavItem[] =>
    navPages.map((page) => ({
      to: `${base}${page.to}` || '/',
      label: page.label,
      icon: page.icon,
      exact: page.exact
    }))

  // Below this the panel is a rail: icons only, labels gone.
  const COMPACT_AT_PX = 90
  const EXPANDED_SIZE = '238px'

  const blockClass = 'grid min-h-[80vh] place-items-center px-6 text-center'

// What the console shows instead of a page to someone it does not open for.
component Blocked
  props { title, detail, homeUrl, children }: { title: string; detail: string; homeUrl: string; children?: unknown }
  div(className={blockClass})
    div(className='max-w-md')
      div(className='mx-auto mb-5 grid size-10 place-items-center rounded-full bg-foreground/5 text-muted-foreground')
        Icon(name='key' size={18})
      p(className='text-sm text-foreground') #{title}
      p(className='mt-2 text-xs text-muted-foreground') #{detail}
      div(className='mt-6 flex flex-wrap items-center justify-center gap-2')
        | #{children}
        a(href={homeUrl} className='inline-flex h-10 items-center rounded-full border border-border px-5 text-sm font-medium text-foreground') Return to Lucky Pick

setup
  // The console opens for a banker — the linked contact of a confirmed or
  // active house — and for the `admin` claim; `readAdminGate` holds the rule.
  // No page renders for anyone else. This is the door, not the lock: every
  // query and mutation the pages call authorizes the caller on the server from
  // their own identity, so nothing here is what keeps the data private.
  const { user, isLoading: isAuthLoading, customClaims } = useFirebaseUser()
  const isSignedIn = user !== null
  const houses = useConvexQuery(api.accounts.q.myHouses, {}, { enabled: isSignedIn })
  const gate = readAdminGate({
    isAuthLoading,
    isSignedIn,
    claims: customClaims,
    houses,
    canReadHouses: convexClient !== null
  })

  // Firebase auth is per-origin, so on the console's own subdomain a banker
  // may arrive with no session at all; signing in here is the way in.
  const [isSigningIn, setIsSigningIn] = useState(false)
  const [signInError, setSignInError] = useState<string | null>(null)
  const startSignIn = useCallback(async () => {
    setIsSigningIn(true)
    setSignInError(null)
    try {
      await signInWithGoogle()
    } catch (error) {
      setSignInError(describeAuthError(error))
    } finally {
      setIsSigningIn(false)
    }
  }, [])

  const [isSidebarCompact, setIsSidebarCompact] = useState(false)
  const navItems =
    typeof window !== 'undefined' && !isAdminSubdomainHostname(window.location.hostname)
      ? toNavItems(adminRoutePrefix)
      : toNavItems('')
  const pathname = useRouterState({ select: (state) => state.location.pathname.replace(/\/$/, '') || '/' })
  const sidebarPanelRef = usePanelRef()

  const handleSidebarResize = (size: PanelSize) => setIsSidebarCompact(size.inPixels <= COMPACT_AT_PX)

  // Three states, one control: collapsed snaps back open, a rail-width panel
  // goes to its full width, and a full-width panel collapses.
  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current
    if (!panel) return

    if (panel.isCollapsed()) panel.expand()
    else if (isSidebarCompact) panel.resize(EXPANDED_SIZE)
    else panel.collapse()
  }

  const homeUrl = typeof window === 'undefined' ? '/' : buildAppUrl(new URL(window.location.href), '/').toString()

main(className='admin-frame')
  Group(id='admin-layout' className='admin-layout' style={{ height: '100dvh' }})
    Panel(
      ~ id='admin-sidebar-panel'
      ~ panelRef={sidebarPanelRef}
      ~ defaultSize={EXPANDED_SIZE}
      ~ minSize='180px'
      ~ maxSize='320px'
      ~ collapsedSize='76px'
      ~ collapsible={true}
      ~ onResize={handleSidebarResize}
      ~ className='admin-sidebar-panel'
      ~ style={{ overflow: 'hidden' }}
      ~ )
      Sidebar(
        ~ path={pathname}
        ~ items={navItems}
        ~ isCompact={isSidebarCompact}
        ~ toggleSidebar={toggleSidebar}
        ~ homeUrl={homeUrl}
        ~ )
        ThemeToggle

    Separator(id='admin-sidebar-resize-separator' aria-label='Resize admin sidebar' className='admin-resize-separator')

    Panel(id='admin-content-panel' minSize='0px' className='admin-content-panel pt-3' style={{ overflow: 'auto' }})
      section(className='admin-content')
        if gate === 'open'
          Outlet
        elseif gate === 'loading'
          div(className='flex min-h-[80vh] items-center justify-center gap-2.5')
            Icon(name='spinner' size={16} className='animate-spin text-muted-foreground')
            p(className='text-sm text-muted-foreground') Checking your access
        elseif gate === 'signed-out'
          Blocked(
            ~ title='Sign in to open the admin console.'
            ~ detail={signInError ?? (isFirebaseConfigured ? 'It is open to bankers and administrators.' : 'Sign-in is not configured on this deployment.')}
            ~ homeUrl={homeUrl}
            ~ )
            if isFirebaseConfigured
              button(
                ~ type='button'
                ~ onClick={() => void startSignIn()}
                ~ disabled={isSigningIn}
                ~ aria-busy={isSigningIn || undefined}
                ~ className='inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background transition-opacity disabled:opacity-60'
                ~ ) #{isSigningIn ? 'Signing in…' : 'Sign in with Google'}
        elseif gate === 'unavailable'
          Blocked(
            ~ title='The admin console is not answering on this deployment.'
            ~ detail='There is no backend here to read your houses from.'
            ~ homeUrl={homeUrl}
            ~ )
        else
          Blocked(
            ~ title='This account cannot open the admin console.'
            ~ detail='It is open to the contact of a confirmed or active house, and to administrators.'
            ~ homeUrl={homeUrl}
            ~ )
