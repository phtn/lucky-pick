import { useContext } from 'octane'
import { NuqsAdapter } from '@octanejs/nuqs/adapters/react'
import { AnalyticsSessionContext, type AnalyticsSession } from '../lib/analytics-session'
import Analytics from './Analytics.btsx'

setup
  const session: AnalyticsSession = {tickets: [], mode: 'solo', draws: [], players: [] }
  if (!session) throw new Error('Analytics requires the app session.')

NuqsAdapter
  Analytics(session={session})
