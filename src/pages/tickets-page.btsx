import BankerPanel from "../components/tickets/BankerPanel.btsx";
import NewBetPanel from "../components/sim/NewBetPanel.btsx";
import NewTicketList from "../components/sim/NewTicketList.btsx";
import { GAME_IDS, GAMES, type BetType, type GameId } from "@/lib/games";
import { useEffect, useState, useRef } from "octane";
import { MAX_TICKETS, OFFICIAL_RESULTS, type BetCost, type Draw, type Ticket } from "@/lib/lotto";
import { useGameSettings } from "@/hooks/use-game-settings";
import { enabledBetTypes, enabledGameIds, stakesFor, ticketCostFor } from "@/lib/game-settings";
import { evenOddPick, randomPick, randomPicks } from "@/lib/rng";
import { formatPeso } from "@/lib/format";
import { useConvexQuery } from "@/hooks/use-convex-query";
import { convexClient } from "@/lib/convex-client";
import { useFirebaseUser } from "@/lib/firebase/auth";
import { api } from "../../convex/_generated/api";
import { MAX_TICKETS_PER_PURCHASE } from "../../convex/tickets/d";

module
  const ticketTimeFormatter = new Intl.DateTimeFormat([], { hour: '2-digit', minute: '2-digit' });

  // One id per press: a retried request replays on the server instead of
  // buying the same tickets twice.
  const newRequestId = () =>
    typeof crypto !== 'undefined' && 'randomUUID' in crypto
      ? crypto.randomUUID()
      : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`;

  // The server's own sentence when it sent one, since it names the remedy
  // (choose a banker, not enough credits); a generic line otherwise.
  const readBuyError = (error: unknown) => {
    const data = (error as { data?: unknown }).data;
    return typeof data === 'string' && data.length > 0 ? data : 'Could not buy that ticket. Try again.';
  };

setup
  const [gameId, setGameId] = useState<GameId>('6/42');
  const [betType, setBetType] = useState<BetType>(6);
  // What the player picked out of the stakes this cell offers. Null — and a
  // stake the house has since withdrawn — falls back to the configured price.
  const [stakeChoice, setStakeChoice] = useState<BetCost | null>(null);
  const [selected, setSelected] = useState<number[]>([9,10,11]);
  // A signed-in player buys real tickets with credits, and the list is read
  // back from Convex. A visitor who is not signed in keeps the local practice
  // board this page always had: nothing is charged and nothing is stored.
  const { user } = useFirebaseUser();
  const isSignedIn = user !== null;
  const realTickets = useConvexQuery(api.tickets.q.mine, {}, { enabled: isSignedIn });
  const [localTickets, setTickets] = useState<Ticket[]>([]);
  const [isBuying, setIsBuying] = useState(false);
  // Numbered from the oldest, so a ticket keeps its number as newer ones arrive above it.
  const tickets: Ticket[] = isSignedIn
    ? (realTickets ?? []).map((row, index, rows) => ({
        id: rows.length - index,
        numbers: row.numbers,
        game: row.game,
        betType: row.betType,
        required: row.betType,
        status: row.status,
        hits: row.hits,
        time: ticketTimeFormatter.format(row.createdAt),
        prizeWon: row.prizeWon ?? undefined,
        cost: row.cost
      }))
    : localTickets;
  // This page sells tickets but does not run a draw yet, so nothing sets these.
  // They are state, not constants, so the draw can be wired in without
  // reshaping what the panels below are handed.
  const [draws] = useState<Draw[]>([]);
  const [drawnBalls] = useState<number[]>([]);
  const [drawGameId] = useState<GameId | null>(null);
  const [isDrawing] = useState(false);
  const [soundOn] = useState(true);
  const [toast, setToast] = useState<string | null>(null);
  const [jackpots] = useState<Record<GameId, number>>(() => {
    const seed = {} as Record<GameId, number>;
    for (const id of GAME_IDS) seed[id] = OFFICIAL_RESULTS[id][0]?.jackpot ?? GAMES[id].baseJackpot;
    return seed;
  });
  const audioCtxRef = useRef<AudioContext | null>(null);
  const masterGainRef = useRef<GainNode | null>(null);
  const idCounterRef = useRef(1);
  const voiceIdRef = useRef(0);
  const voiceMapRef = useRef<Map<number, { osc: OscillatorNode; gain: GainNode }>>(new Map());
  const timersRef = useRef(new Set<number>());

  // Sound and toast timers belong to this mounted page.
  const schedule = (callback: VoidFunction, delay: number) => {
    const timer = window.setTimeout(() => {
      timersRef.current.delete(timer);
      callback();
    }, delay);
    timersRef.current.add(timer);
    return timer;
  };

  const required = betType;
  const game = GAMES[gameId];
  const pool = game.pool;
  const jackpot = jackpots[gameId];

  // What the house currently sells, from the `games` table in Convex. An
  // unconfigured deployment resolves to the static config, so every game and
  // every bet type is on sale at the code's own price.
  const gameSettings = useGameSettings();
  const sellableGames = enabledGameIds(gameSettings);
  const sellableBetTypes = enabledBetTypes(gameSettings[gameId]);
  const stakes = stakesFor(gameSettings, gameId, betType);
  // The configured price is what a ticket costs unless the player picked
  // another stake this cell actually offers.
  const betCost: BetCost =
    stakeChoice !== null && stakes.includes(stakeChoice) ? stakeChoice : ticketCostFor(gameSettings, gameId, betType);

  // The house can withdraw a game, or one of its bet types, while someone is
  // sitting on it. The board moves to something still on sale rather than
  // taking bets on what is closed; the selection is trimmed to fit what it
  // moved to, the same way switching by hand does.
  useEffect(() => {
    if (sellableGames.includes(gameId)) return;
    const next = sellableGames[0];
    setGameId(next);
    setSelected(prev => prev.filter(n => n <= GAMES[next].pool));
  }, [sellableGames.join(','), gameId]);

  useEffect(() => {
    if (sellableBetTypes.includes(betType)) return;
    const next = sellableBetTypes[sellableBetTypes.length - 1];
    setBetType(next);
    setSelected(prev => prev.slice(0, next).sort((a, b) => a - b));
  }, [sellableBetTypes.join(','), betType]);
  const ticketCount = tickets.length

  const showToast = (msg: string) => {
    setToast(msg);
    schedule(()=>setToast(null), 2400);
  };

  const getAudio = () => {
    if (!audioCtxRef.current) {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const master = ctx.createGain();
      master.gain.value = 0.45;
      const comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -18; comp.knee.value = 30; comp.ratio.value = 12; comp.attack.value = 0.003; comp.release.value = 0.25;
      master.connect(comp).connect(ctx.destination);
      audioCtxRef.current = ctx;
      masterGainRef.current = master;
    }
    const ctx = audioCtxRef.current!;
    if (ctx.state !== 'running') ctx.resume();
    try { if ((navigator as any).audioSession) (navigator as any).audioSession.type = 'playback'; } catch {}
    return ctx;
  };

  useEffect(()=>{
    const onVis = () => { if (document.visibilityState==='visible' && audioCtxRef.current?.state!=='running') audioCtxRef.current?.resume(); };
    document.addEventListener('visibilitychange', onVis);
    window.addEventListener('pageshow', onVis);
    return () => {
      document.removeEventListener('visibilitychange', onVis);
      window.removeEventListener('pageshow', onVis);
      timersRef.current.forEach(timer => window.clearTimeout(timer));
      timersRef.current.clear();
      voiceMapRef.current.clear();
      const audio = audioCtxRef.current;
      if (audio && audio.state !== 'closed') void audio.close().catch(() => {});
    };
  },[]);

  const playTone = (freq: number, dur = 0.35, type: OscillatorType='sine', peak=0.18) => {
    if(!soundOn) return;
    try{
      const ctx=getAudio();
      const id=voiceIdRef.current++;
      const osc=ctx.createOscillator(); const g=ctx.createGain();
      osc.type=type; osc.frequency.value=freq;
      const now=ctx.currentTime;
      g.gain.setValueAtTime(0.0001,now); g.gain.exponentialRampToValueAtTime(peak,now+0.02); g.gain.exponentialRampToValueAtTime(0.0001,now+dur);
      osc.connect(g); g.connect(masterGainRef.current!);
      voiceMapRef.current.set(id,{osc,gain:g});
      osc.start(now); osc.stop(now+dur+0.05);
      schedule(()=>{ if(voiceMapRef.current.get(id)?.osc===osc) voiceMapRef.current.delete(id); },(dur+0.15)*1000);
    }catch{}
  };

  const toggleNumber = (n:number) => {
    setSelected(prev=>{
      if(prev.includes(n)) return prev.filter(x=>x!==n);
      if(prev.length>=required){ const copy=[...prev]; copy[copy.length-1]=n; return copy; }
      return [...prev,n].sort((a,b)=>a-b);
    });
    playTone(650+Math.random()*200,0.15,'sine',0.12);
  };
  const quickPick=async()=>{
    playTone(800,0.2,'triangle',0.14);
    setSelected(await randomPick(required, pool));
  };
  const evenOddMix=async()=>{
    playTone(700,0.18,'sine',0.13);
    setSelected(await evenOddPick(required, pool));
  };


  // The one path that spends credits. Picks are sent as they are; the server
  // re-checks every one of them, the price, and the balance.
  const buyReal = async (picks: number[][]) => {
    if (!convexClient || isBuying) return false;
    setIsBuying(true);
    try {
      const result = await convexClient.mutation(api.tickets.m.buy, { game: gameId, betType, cost: betCost, picks, requestId: newRequestId() });
      playTone(900,0.25,'triangle',0.16);
      showToast(`${result.bought === 1 ? 'Ticket bought' : `×${result.bought} tickets bought`} • ${result.spent.toLocaleString('en-US')} CR`);
      return true;
    } catch (error) {
      showToast(readBuyError(error));
      return false;
    } finally {
      setIsBuying(false);
    }
  };

  const addTicket = () => {
    if(selected.length!==required) return;
    if (isSignedIn) { void buyReal([[...selected].sort((a,b)=>a-b)]); return; }
    const nowTime=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
    const base: Ticket = { id:idCounterRef.current++, numbers:[...selected].sort((a,b)=>a-b), game:gameId, betType, required, status:'pending', hits:0, time:nowTime, cost:betCost };
    setTickets(prev=>[base,...prev]);
    playTone(900,0.25,'triangle',0.16);
    showToast('Ticket added!');
  };

  // Random-bet multipliers: buy 1, 10, 20 ... 200 machine picks in one tap.
  const addRandomTickets = async (count: number) => {
    if (isDrawing) return;
    if (isSignedIn) {
      const size = Math.min(count, MAX_TICKETS_PER_PURCHASE);
      const picks = await randomPicks(size, required, pool);
      if (await buyReal(picks)) setSelected(picks[0]);
      return;
    }
    const room = MAX_TICKETS - ticketCount;
    if (room <= 0) { showToast(`Ticket limit reached (${MAX_TICKETS} tickets) — clear some first`); return; }
    const size = Math.min(count, room);
    const nowTime=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
    // Every pick in the batch comes off the same seeded stream, one nonce per
    // number, so a bulk buy is as reproducible as a single hand-picked bet.
    const picks = await randomPicks(size, required, pool);
    const batch: Ticket[] = picks.map((numbers) => ({
      id: idCounterRef.current++,
      numbers,
      game: gameId,
      betType,
      required,
      status: 'pending' as const,
      hits: 0,
      time: nowTime,
      cost: betCost,
    }));
    setTickets(prev=>[...batch,...prev]);
    setSelected(batch[0].numbers);
    playTone(880,0.22,'triangle',0.15);
    schedule(()=>playTone(1180,0.18,'sine',0.12),90);
    const clipped = size < count ? ` (capped from ×${count})` : '';
    showToast(`×${size} random ${game.id} bets • ${formatPeso(size*betCost)}${clipped}`);
  };

  // A bet type is also the size of a ticket, so the selection is trimmed to fit.
  const selectBetType = (bt: BetType) => {
    if (!sellableBetTypes.includes(bt)) return;
    setBetType(bt);
    setSelected(prev => prev.slice(0, bt).sort((a, b) => a - b));
  };

div(className="app-main-grid grid grid-cols-1 xl:grid-cols-[360px_1fr_380px] gap-4 md:gap-8 items-start")
  if toast
    div(className="fixed top-5 right-5 z-[9999] max-w-[min(20rem,calc(100vw-2.5rem))] px-4 py-2.5 rounded-full bg-ball text-ball-ink text-[13px] font-bold shadow-[0_8px_24px_rgba(0,0,0,0.4)] animate-[winnerPop_0.4s_ease]")
      | #{toast}

  // BANKER COLUMN
  div(className="app-column app-column--bet order-2 xl:order-1 space-y-4")
    BankerPanel(game={game})

  // NUMBER PICKER COLUMN
  div(className="app-column app-column--draw order-1 xl:order-2")
    NewBetPanel(
      ~ game={game}
      ~ jackpot={jackpot}
      ~ betType={betType}
      ~ betCost={betCost}
      ~ betTypes={sellableBetTypes}
      ~ stakes={stakes}
      ~ onSelectStake={setStakeChoice}
      ~ selected={selected}
      ~ ticketCount={ticketCount}
      ~ buyerTag=""
      ~ buyerLabel="you"
      ~ isDrawing={isDrawing || isBuying}
      ~ onSelectBetType={selectBetType}
      ~ onToggleNumber={toggleNumber}
      ~ onQuickPick={quickPick}
      ~ onEvenOddMix={evenOddMix}
      ~ onClearSelection={() => setSelected([])}
      ~ onBuyRandom={addRandomTickets}
      ~ onAddTicket={addTicket}
      ~ )

  // TICKET LIST COLUMN
  div(className="app-column app-column--info order-3 space-y-4")
    NewTicketList(
      ~ tickets={tickets}
      ~ draws={draws}
      ~ drawnBalls={drawnBalls}
      ~ drawGame={drawGameId}
      ~ onClear={() => isSignedIn ? showToast('Bought tickets stay until their draw settles them.') : setTickets([])}
      ~ )
