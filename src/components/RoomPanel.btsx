import { Crown, Link2, UserPlus } from '@octanejs/lucide';
import { paintFor } from '../lib/theme-colors';
import type { Player } from '../lib/lotto';

module
  interface RoomPanelProps {
    /** Five-character invite code, also the URL hash. */
    roomCode: string;
    onCopyInvite: () => void;
    players: Player[];
    /** Index into `players` whose tickets the bet panel buys for. */
    currentPlayerIdx: number;
    onSelectPlayer: (idx: number) => void;
    newPlayerName: string;
    onNewPlayerName: (value: string) => void;
    onAddPlayer: () => void;
  }

props { roomCode, onCopyInvite, players, currentPlayerIdx, onSelectPlayer, newPlayerName, onNewPlayerName, onAddPlayer }: RoomPanelProps

div(className="rounded-[20px] bg-card border border-border p-4")
  div(className="flex items-center justify-between mb-3")
    h3(className="text-[11px] font-black tracking-widest flex items-center gap-1.5")
      Crown(className="w-4 h-4 text-primary")
      | #{" ROOM "}
      | #{roomCode}
    button(
      ~ onClick={onCopyInvite}
      ~ className="h-7 px-3 rounded-full bg-elevated border border-border text-[10px] font-bold flex items-center gap-1 hover:bg-elevated transition"
      ~ )
      Link2(className="w-3 h-3")
      | #{" Copy Invite"}
  div(className="flex gap-2 mb-3")
    input(
      ~ value={newPlayerName}
      ~ onInput={e => onNewPlayerName(e.currentTarget.value)}
      ~ onKeyDown={e => e.key === 'Enter' && onAddPlayer()}
      ~ placeholder="Add player name"
      ~ className="flex-1 h-9 rounded-full bg-sunken border border-border px-3.5 text-[12px] placeholder:text-muted-foreground/70 focus:outline-none focus:border-primary/40"
      ~ )
    button(
      ~ onClick={onAddPlayer}
      ~ className="w-9 h-9 rounded-full bg-primary text-primary-foreground flex items-center justify-center hover:brightness-110 active:scale-95"
      ~ )
      UserPlus(className="w-4 h-4")
  div(className="flex flex-wrap gap-2")
    each p, idx in players key p.id
      button(
        ~ onClick={() => onSelectPlayer(idx)}
        ~ className={`h-8 px-3 rounded-full border text-[12px] font-bold flex items-center gap-1.5 transition ${idx === currentPlayerIdx ? 'bg-ball text-ball-ink border-border shadow' : 'bg-sunken border-border text-foreground/70 hover:text-foreground hover:bg-elevated'}`}
        ~ )
        span(
          ~ className="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-black"
          ~ style={paintFor(p.color)}
          ~ )
          | #{p.avatar}
        | #{p.name}
        | #{" "}
        span(className="text-[10px] opacity-60")
          | #{p.tickets.length}
  if players.length < 8
    p(className="mt-2 text-[10px] text-muted-foreground")
      | Up to 8 players • All bet on same draw
  else
    p(className="mt-2 text-[10px] text-destructive")
      | Room full (8/8)
