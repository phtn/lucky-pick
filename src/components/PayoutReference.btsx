import Paytable from './Paytable.btsx';
import type { BetType, GameConfig } from '../lib/games';
import type { BetCost } from '../lib/lotto';
import {Icon} from '@/lib/icons';

module
  interface PayoutReferenceProps {
    game: GameConfig;
    jackpot: number;
    betType: BetType;
    betCost: BetCost;
  }

props { game, jackpot, betType, betCost }: PayoutReferenceProps

details(className="payout-reference collapsible rounded-[20px] bg-card")
  summary(className="flex cursor-pointer list-none items-center gap-2 p-4 text-[11px] font-black tracking-widest text-foreground/70")
    Icon(name='table-props' className="w-3.5 h-3.5 text-primary")
    span(className="flex-1 select-none ") PAYOUT TABLE
    span(className="text-[9px] tracking-normal text-muted-foreground")
      | #{betType === 6 ? 'JACKPOT TIERS' : 'PICK BETS'}
    Icon(name='chevron-down' className="collapsible__chevron w-3.5 h-3.5 text-muted-foreground")
  div(className="px-3 pb-3")
    Paytable(
      ~ game={game}
      ~ betType={betType}
      ~ jackpot={jackpot}
      ~ betCost={betCost}
      ~ showAll
      ~ )
