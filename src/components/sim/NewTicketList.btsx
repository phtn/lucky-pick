import { useMemo, useState } from 'octane';
import TabPanel, { TabPanelContent, TabPanelList, TabPanelTrigger } from '@/components/ui/tab-panel.btsx';
import { VISIBLE_TICKETS, rankTickets, type Ticket } from '@/lib/lotto';
import type { GameId } from '@/lib/games';
import { cn } from '@/lib/utils';

module
  interface TicketListProps {
    tickets: Ticket[];
    /** Balls revealed so far in the running draw. */
    drawnBalls?: number[];
    drawGame?: GameId | null;
  }

  const emptyBalls: number[] = [];
  const historyPageSize = 100;
  const panelClass = 'max-h-[520px] space-y-2.5 overflow-y-auto custom-scroll py-1';

component TicketRow
  props { ticket, liveDrawn, liveHits = 0, leading = false }: { ticket: Ticket; liveDrawn?: ReadonlySet<number>; liveHits?: number; leading?: boolean }
  setup const settled = ticket.status !== 'pending';

  div(className={cn('flex items-center justify-between rounded-full p-1.5 transition', ticket.status === 'won' ? 'bg-gradient-to-br from-primary/5 to-primary/1' : 'bg-raised', ticket.status === 'lost' && 'opacity-70', leading && liveHits > 0 && 'ring-1 ring-primary/50')})
    div(className="flex flex-wrap gap-1.5")
      each n in ticket.numbers key n
        span(className={cn('flex size-7 items-center justify-center rounded-full font-sans text-base font-[550] transition', liveDrawn?.has(n) ? 'bg-primary text-primary-foreground' : settled ? 'bg-elevated/60 text-muted-foreground' : 'bg-foreground text-background')}) #{n}
    div(className="flex shrink-0 items-center gap-1.5")
      if settled
        fragment
          span(className="text-xs tabular-nums text-muted-foreground" title="Numbers matched") #{ticket.hits}/#{ticket.required}
          if ticket.status === 'won'
            span(className="text-xs font-bold text-emerald-500") WIN
          else
            span(className="text-xs font-bold text-rose-400") LOST
      elseif liveHits > 0
        span(className="whitespace-nowrap text-xs font-bold tracking-tight text-blue-500") #{liveHits}x
      div(className="flex items-center justify-end px-1.5 py-0.5 font-sans text-base font-[500] text-foreground space-x-3")
        p(className='text-muted-foreground') #{ticket.game}
        p(className='w-[36px]! text-right') #{ticket.cost}

props { tickets, drawnBalls = emptyBalls, drawGame = null }: TicketListProps
setup
  const { pending, history } = useMemo(() => {
    const pending: Ticket[] = [];
    const history: Ticket[] = [];
    for (const ticket of tickets) {
      (ticket.status === 'pending' ? pending : history).push(ticket);
    }
    return { pending, history };
  }, [tickets]);
  const ranked = useMemo(() => rankTickets(pending, drawnBalls, drawGame), [pending, drawnBalls, drawGame]);
  const liveDrawn = useMemo(() => new Set(drawnBalls), [drawnBalls]);
  const [historyLimit, setHistoryLimit] = useState(historyPageSize);

TabPanel(defaultValue="tickets" className="space-y-1 p-2")
  TabPanelList(aria-label="Tickets" className="justify-between")
    TabPanelTrigger(value="tickets" className="gap-2 px-2 py-1 text-xs font-bold tracking-[0.02em]")
      | MY TICKETS
      span(className="flex size-6 items-center justify-center rounded-full bg-elevated/40 text-sm font-semibold") #{pending.length}
    TabPanelTrigger(value="history" className="px-2 py-1") History

  TabPanelContent(value="tickets" className={panelClass})
    if pending.length === 0
      p(className="py-12 text-center text-[13px] font-medium text-muted-foreground") #{history.length ? 'No open tickets' : 'No tickets yet'}
    else
      fragment
        if pending.length > VISIBLE_TICKETS
          p(className="py-1 text-center text-[10px] text-muted-foreground") Showing #{VISIBLE_TICKETS} of #{pending.length} open tickets
        each entry, idx in ranked.slice(0, VISIBLE_TICKETS) key entry.ticket.id
          TicketRow(ticket={entry.ticket} liveDrawn={entry.ticket.game === drawGame ? liveDrawn : undefined} liveHits={entry.hits} leading={idx === 0})

  TabPanelContent(value="history" className={panelClass})
    each ticket in history.slice(0, historyLimit) key ticket.id
      TicketRow(ticket={ticket})
    empty
      p(className="py-12 text-center text-[13px] font-medium text-muted-foreground") No drawn tickets yet
    if history.length > historyLimit
      button(type="button" onClick={() => setHistoryLimit(limit => limit + historyPageSize)} className="mx-auto block rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-raised hover:text-foreground") Show more tickets
