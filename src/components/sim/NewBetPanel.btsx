import NumberGrid from './NumberGrid.btsx';
import Paytable from './Paytable.btsx';
import RandomBets from './RandomBets.btsx';
import { type BetType, type GameConfig } from '@/lib/games';
import { BET_TYPES, type BetCost } from '@/lib/lotto';
import { formatPeso } from '@/lib/format';
import BetAction from "./BetAction.btsx";
import NewNumberGrid from "./NewNumberGrid.btsx";

module
  // Everything that composes one bet: the bet type, its paytable, the board,
  // the bulk-buy shortcuts, and the confirm button.
  interface BetPanelProps {
    game: GameConfig;
    jackpot: number;
    betType: BetType;
    betCost: BetCost;
    /**
     * The bet types this game sells, as the house configured them. Absent means
     * all six, which is what an unconfigured deployment offers.
     */
    betTypes?: BetType[];
    /** The stakes this cell offers. One stake is a price, not a choice, so the row is hidden. */
    stakes?: number[];
    onSelectStake?: (stake: BetCost) => void;
    selected: number[];
    /** Open tickets for whoever is buying, against the MAX_TICKETS cap. */
    ticketCount: number;
    /** '• Name' in party mode, empty in solo, appended to the headings. */
    buyerTag: string;
    /** Who a bulk buy is for, e.g. 'you' or a party player's name. */
    buyerLabel: string;
    isDrawing: boolean;
    onSelectBetType: (bt: BetType) => void;
    onToggleNumber: (n: number) => void;
    onQuickPick: () => void;
    onEvenOddMix: () => void;
    onClearSelection: () => void;
    onBuyRandom: (count: number) => Promise<void>;
    onAddTicket: () => void;
  }

props { game, jackpot, betType, betCost, betTypes, stakes, onSelectStake, selected, ticketCount, buyerTag, buyerLabel, isDrawing, onSelectBetType, onToggleNumber, onQuickPick, onEvenOddMix, onClearSelection, onBuyRandom, onAddTicket }: BetPanelProps
setup
  const pool = game.pool;
  // A bet type is also the count of numbers a ticket holds.
  const required = betType;
  const sellable = betTypes ?? BET_TYPES;
  const stakeOptions = stakes ?? [];

div(className="bet-panel bg-sunken p-8! border rounded-[2rem]")
  div(className='flex items-center justify-between mb-4')
    div
      div(className="flex items-center justify-between")
        h2(className="text-xs font-bold tracking-[0.12em] flex items-center gap-2") STAKES
      div(className="mb-2")
        div(className="hidden _grid grid-cols-3 gap-1 p-1 rounded-[16px]")
          each bt in sellable key bt
            button(
              ~ onClick={() => onSelectBetType(bt)}
              ~ className={`bet-type-button h-9 rounded-md text-xs font-black tracking-wide transition ${betType === bt ? 'bg-primary text-primary-foreground shadow-[0_0_12px_var(--lp-glow)]' : 'bg-raised text-foreground/70 hover:bg-elevated hover:text-foreground'}`}
              ~ )
              | #{bt}
              | #{"/6 "}
              | #{bt === 6 ? 'JACKPOT' : ''}
      if stakeOptions.length > 1
        div(className="mb-2")
          div(className="flex items-center gap-1")
            each stake in stakeOptions key stake
              button(
                ~ onClick={() => onSelectStake && onSelectStake(stake)}
                ~ aria-pressed={betCost === stake}
                ~ className={`h-7 rounded-md px-2.5 text-sm font-black tracking-wide transition ${betCost === stake ? 'bg-primary text-primary-foreground' : 'bg-raised text-foreground/70 hover:bg-elevated hover:text-foreground'}`}
                ~ )
                | #{formatPeso(stake)}
    div(className='flex items-center justify-center')
      Paytable(
        ~ game={game}
        ~ betType={betType}
        ~ jackpot={jackpot}
        ~ betCost={betCost}
        ~ )
  NewNumberGrid(
    ~ pool={pool}
    ~ selected={selected}
    ~ onToggleNumber={onToggleNumber}
    ~ onQuickPick={onQuickPick}
    ~ onEvenOddMix={onEvenOddMix}
    ~ onClear={onClearSelection}
    ~ )
  BetAction(
    ~ gameId={game.id}
    ~ required={required}
    ~ betCost={betCost}
    ~ ticketCount={ticketCount}
    ~ buyerLabel={buyerLabel}
    ~ isDrawing={isDrawing}
    ~ betReady={selected.length === required}
    ~ buyerTag={buyerTag}
    ~ onBuy={onBuyRandom}
    ~ onAddTicket={onAddTicket}
    ~ )
