import { Moon, Sun, User, Users, Volume2, VolumeX } from '@octanejs/lucide';
import AccountSwitcher from './AccountSwitcher.btsx';
import { DropdownMenuCheckboxItem, DropdownMenuLabel, DropdownMenuRadioGroup, DropdownMenuRadioItem, DropdownMenuSeparator } from './ui/dropdown-menu.btsx';
import { THEMES, type ThemeId, type ThemeMode } from '../lib/theme';
import type { GameMode } from '../lib/lotto';

module
  interface AppHeaderProps {
    /** Ball pool of the selected game, shown inside the wordmark. */
    pool: number;
    gameName: string;
    mode: GameMode;
    onSelectMode: (next: GameMode) => void;
    soundOn: boolean;
    onToggleSound: () => void;
    theme: ThemeId;
    themeMode: ThemeMode;
    onToggleThemeMode: () => void;
    onPickTheme: (next: ThemeId) => void;
    /** Routes sign-in results into the app's toast. */
    onNotify: (message: string) => void;
  }

  // Checkbox and radio rows keep the menu open on click, so the whole header's
  // worth of settings can be worked through in one visit.
  const rowClass = 'gap-1 p-2 hover:bg-foreground/10!';

props { pool, gameName, mode, onSelectMode, soundOn, onToggleSound, theme, themeMode, onToggleThemeMode, onPickTheme, onNotify }: AppHeaderProps

header(className="mb-4")
  div(className="flex flex-wrap items-center justify-between gap-3")
    div(className="flex items-center gap-3")
      div(className="brand-mark")
        span(className="brand-mark__number")
          | #{pool}
        span(className="brand-mark__orbit animate-spin blur-xs" aria-hidden="true")
        span(className="brand-mark__orbit -rotate-12 scale-130 opacity-20 animate-pulse" aria-hidden="true")
        span(className="brand-mark__orbit" aria-hidden="true")
      div
        h1(className="flex items-center gap-2 text-[22px] md:text-xl font-bold tracking-tighter leading-none")
          span Lucky Pick
          span(className="live-chip text-[10px] uppercase tracking-[0.18em]")
            span(className="w-1.5 h-1.5 rounded-full bg-destructive animate-pulse")
            | #{" Live"}
        p(className="text-[10px] uppercase tracking-[0.18em] text-muted-foreground font-semibold mt-1.5 flex items-center gap-2")
          span
            | #{gameName}
            | #{" • Philippines"}

    div(className="flex items-center gap-2")
      AccountSwitcher(onNotify={onNotify})
        DropdownMenuSeparator
        DropdownMenuLabel(className="font-normal text-xs text-muted-foreground opacity-80") Mode
        DropdownMenuRadioGroup(value={mode} onValueChange={(next) => onSelectMode(next as GameMode)})
          DropdownMenuRadioItem(value="solo" className={rowClass})
            div(className="flex size-6 items-center justify-center")
              User(className="w-3.5 h-3.5")
            span(className="truncate") Solo
          DropdownMenuRadioItem(value="party" className={rowClass})
            div(className="flex size-6 items-center justify-center")
              Users(className="w-3.5 h-3.5")
            span(className="truncate") Party

        DropdownMenuSeparator
        DropdownMenuCheckboxItem(checked={soundOn} onCheckedChange={onToggleSound} className={rowClass})
          div(className="flex size-6 items-center justify-center")
            if soundOn
              Volume2(className="w-3.5 h-3.5")
            else
              VolumeX(className="w-3.5 h-3.5 text-muted-foreground")
          span(className="truncate") Sound
        DropdownMenuCheckboxItem(checked={themeMode === 'dark'} onCheckedChange={onToggleThemeMode} className={rowClass})
          div(className="flex size-6 items-center justify-center")
            if themeMode === 'dark'
              Moon(className="w-3.5 h-3.5")
            else
              Sun(className="w-3.5 h-3.5")
          span(className="truncate") Dark mode

        DropdownMenuSeparator
        DropdownMenuLabel(className="font-normal text-xs text-muted-foreground opacity-80") Theme
        DropdownMenuRadioGroup(value={theme} onValueChange={(next) => onPickTheme(next as ThemeId)})
          each t in THEMES key t.id
            DropdownMenuRadioItem(value={t.id} className={rowClass})
              div(className="flex size-6 items-center justify-center")
                span(
                  ~ className={`w-4 h-4 rounded-full shrink-0 ${themeMode === 'dark' ? 'dark' : ''}`}
                  ~ data-theme={t.id}
                  ~ style={{ background: 'linear-gradient(135deg, var(--primary) 0 50%, var(--destructive) 50% 100%)' }}
                  ~ )
              span(className="min-w-0 flex-1")
                span(className="block text-[12px] font-bold leading-none truncate")
                  | #{t.name}
                span(className="block text-[10px] opacity-60 mt-1 truncate")
                  | #{t.blurb}
