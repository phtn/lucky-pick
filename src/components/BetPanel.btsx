import NumberGrid from './NumberGrid.btsx';
import Paytable from './Paytable.btsx';
import RandomBets from './RandomBets.btsx';
import { type BetType, type GameConfig } from '../lib/games';
import { BET_TYPES, type BetCost } from '../lib/lotto';

module
  // Everything that composes one bet: the bet type, its paytable, the board,
  // the bulk-buy shortcuts, and the confirm button.
  interface BetPanelProps {
    game: GameConfig;
    jackpot: number;
    betType: BetType;
    betCost: BetCost;
    selected: number[];
    /** Open tickets for whoever is buying, against the MAX_TICKETS cap. */
    ticketCount: number;
    /** '• Name' in party mode, empty in solo, appended to the headings. */
    buyerTag: string;
    /** Who a bulk buy is for, e.g. 'you' or a party player's name. */
    buyerLabel: string;
    isDrawing: boolean;
    onSelectBetType: (bt: BetType) => void;
    onToggleNumber: (n: number) => void;
    onQuickPick: () => void;
    onEvenOddMix: () => void;
    onClearSelection: () => void;
    onBuyRandom: (count: number) => Promise<void>;
    onAddTicket: () => void;
  }

props { game, jackpot, betType, betCost, selected, ticketCount, buyerTag, buyerLabel, isDrawing, onSelectBetType, onToggleNumber, onQuickPick, onEvenOddMix, onClearSelection, onBuyRandom, onAddTicket }: BetPanelProps
setup
  const pool = game.pool;
  // A bet type is also the count of numbers a ticket holds.
  const required = betType;

div(className="bet-panel p-4")
  div(className="flex items-center justify-between")
    h2(className="text-xs font-bold tracking-[0.12em] flex items-center gap-2")
      | #{" PICK YOUR NUMBERS"}
    span(className="opacity-0 text-xs font-bold px-2.5 rounded-full bg-sunken text-foreground/80")
      | #{selected.length}
      | /
      | #{required}
      | #{" SELECTED "}
      | #{buyerTag}
  div(className="mb-2")
    p(className="opacity-0 font-mono font-thin text-[10px] tracking-widest text-muted-foreground/80 mb-1")
      | BET TYPE
    div(className="grid grid-cols-3 gap-1 p-1 rounded-[16px]")
      each bt in BET_TYPES key bt
        button(
          ~ onClick={() => onSelectBetType(bt)}
          ~ className={`bet-type-button h-9 rounded-md text-xs font-black tracking-wide transition ${betType === bt ? 'bg-primary text-primary-foreground shadow-[0_0_12px_var(--lp-glow)]' : 'bg-raised text-foreground/70 hover:bg-elevated hover:text-foreground'}`}
          ~ )
          | #{bt}
          | #{"/6 "}
          | #{bt === 6 ? 'JACKPOT' : ''}
  Paytable(
    ~ game={game}
    ~ betType={betType}
    ~ jackpot={jackpot}
    ~ betCost={betCost}
    ~ )
  NumberGrid(
    ~ pool={pool}
    ~ selected={selected}
    ~ onToggleNumber={onToggleNumber}
    ~ onQuickPick={onQuickPick}
    ~ onEvenOddMix={onEvenOddMix}
    ~ onClear={onClearSelection}
    ~ )
  RandomBets(
    ~ gameId={game.id}
    ~ required={required}
    ~ betCost={betCost}
    ~ ticketCount={ticketCount}
    ~ buyerLabel={buyerLabel}
    ~ isDrawing={isDrawing}
    ~ betReady={selected.length === required}
    ~ buyerTag={buyerTag}
    ~ onBuy={onBuyRandom}
    ~ onAddTicket={onAddTicket}
    ~ )
