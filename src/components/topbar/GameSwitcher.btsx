import { GAME_IDS, GAMES, type GameConfig, type GameId } from '@/lib/games';
import { formatCompactPeso } from '@/lib/format';
import { cn } from '@/lib/utils';

module
  interface GameSwitcherProps {
    game: GameConfig;
    gameId: GameId;
    /** Current rolling pot per game, so each chip shows its own headline. */
    jackpots: Record<GameId, number>;
    /** A draw in flight locks the switcher. */
    isDrawing: boolean;
    /**
     * The games on sale, in rail order. Absent means every game the code knows,
     * which is what a surface with no configuration behind it shows.
     */
    gameIds?: GameId[];
    onSwitchGame?: (next: GameId) => void;
  }

props { game, gameId, jackpots, isDrawing, gameIds, onSwitchGame }: GameSwitcherProps

setup
  const rail = gameIds ?? GAME_IDS;

div(className="game-switcher hidden! xl:flex!")
  div(className="game-rail scale-80" aria-label="Choose a lottery game")
    each g in rail key g
      button(
        ~ onClick={() => onSwitchGame && onSwitchGame(g)}
        ~ disabled={isDrawing}
        ~ className={cn('game-chip', { 'game-chip--active': gameId === g })}
        ~ )
        span(className="flex justify-center items-baseline gap-4 font-bold leading-none tracking-[-0.02em]")
          span(className="text-base")
            | #{g}
          span(className={cn('hidden md:flex text-base font-normal text-foreground/35', { 'text-[color:var(--primary-foreground)]': gameId === g })})
            | #{formatCompactPeso(jackpots[g])}
        span(className={cn('hidden md:block text-[9px] font-semibold tracking-[0.14em] mt-0.75 truncate text-muted-foreground', { 'text-[color:var(--primary-foreground)] opacity-80': gameId === g })})
          | #{GAMES[g].name.toUpperCase()}
  p(className="hidden mt-2 px-0.5 text-[10px] font-semibold tracking-[0.1em] text-muted-foreground/70 uppercase")
    | #{game.drawDayLabel}
    | #{" • 9PM Manila • Pool 1-"}
    | #{game.pool}
