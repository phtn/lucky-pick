import { GAME_IDS, GAMES, type GameId } from '@/lib/games';
import { formatCompactPeso, formatJackpot } from '@/lib/format';
import { cn } from '@/lib/utils';

module
  interface GameSwitcherProps {
    gameId: GameId;
    jackpots: Partial<Record<GameId, number>>;
    /** A draw in flight locks the switcher. */
    isDrawing: boolean;
    /**
     * The games on sale, in rail order. Absent means every game the code knows,
     * which is what a surface with no configuration behind it shows.
     */
    gameIds?: GameId[];
    onSwitchGame?: (next: GameId) => void;
  }

props { gameId, jackpots, isDrawing, gameIds, onSwitchGame }: GameSwitcherProps

setup
  const rail = gameIds ?? GAME_IDS;
  const route = window.location.pathname

div(className={cn('game-switcher', {'hidden': route !== '/tickets'})})
  div(className="game-rail" role="group" aria-label="Choose a lottery game")
    each g in rail key g
      scope
        setup
          const jackpot = jackpots[g];
          const prize = jackpot === undefined ? 'Jackpot unavailable' : `Latest draw jackpot ${formatJackpot(jackpot)}`;
        button(
          ~ type="button"
          ~ onClick={() => onSwitchGame?.(g)}
          ~ disabled={isDrawing}
          ~ aria-pressed={gameId === g}
          ~ aria-label={`${GAMES[g].name}, ${prize}`}
          ~ title={prize}
          ~ className={cn('game-chip portrait:rounded-md', { 'game-chip--active': gameId === g })}
          ~ )
          span(className="flex flex-col items-center justify-center gap-0.5 font-bold leading-none md:landscape:flex-row md:landscape:items-baseline md:landscape:gap-2")
            span(className="text-sm tracking-[-0.02em] font-bold") #{g}
            span(className="text-[10px] font-normal opacity-80 sm:text-xs") #{jackpot === undefined ? '—' : formatCompactPeso(jackpot)}
          span(className="hidden md:block text-[9px] font-semibold tracking-[0.14em] mt-0.75 truncate opacity-80")
            | #{GAMES[g].name.replace(` ${g}`, '').toUpperCase()}
