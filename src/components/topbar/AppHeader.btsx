import Topbar from './Topbar.btsx';
import { useState } from 'octane';
import { useGameSelection } from '@/lib/game-selection';
import { GAMES } from '@/lib/games';
import { applyTheme, readStoredTheme, type ThemeMode } from '@/lib/theme';

setup
  const { gameId, sellableGames, selectGame, jackpots } = useGameSelection();
  const game = GAMES[gameId];
  const { theme, mode } = readStoredTheme();
  const [themeMode, setThemeMode] = useState<ThemeMode>(mode);
  const [soundOn, setSoundOn] = useState(true);
  const toggleMode = () => {
    const next = themeMode === 'dark' ? 'light' : 'dark';
    applyTheme({ theme, mode: next });
    setThemeMode(next);
  };

Topbar(
  ~ pool={game.pool}
  ~ gameName={game.name}
  ~ gameId={gameId}
  ~ jackpots={jackpots}
  ~ isDrawing={false}
  ~ gameIds={sellableGames}
  ~ onSwitchGame={selectGame}
  ~ mode="solo"
  ~ soundOn={soundOn}
  ~ onToggleSound={() => setSoundOn(v => !v)}
  ~ theme={theme}
  ~ themeMode={themeMode}
  ~ onToggleThemeMode={toggleMode}
  ~ )
