import { ChevronDown, Clock } from '@octanejs/lucide';
import type { Draw } from '../lib/lotto';

module
  // The last few draws of this session, newest first, across all games.

props { draws }: { draws: Draw[] }

details(className="collapsible rounded-[18px] bg-sunken")
  summary(className="flex cursor-pointer list-none items-center gap-1.5 p-4 text-[11px] font-black tracking-widest")
    Clock(className="w-3.5 h-3.5 text-primary")
    span(className="flex-1") DRAW HISTORY
    span(className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-elevated")
      | #{draws.length}
    ChevronDown(className="collapsible__chevron w-3.5 h-3.5 text-muted-foreground")
  if draws.length === 0
    p(className="px-4 pb-4 text-[12px] text-muted-foreground/70 text-center")
      | No draws yet — hit START DRAW
  else
    div(className="space-y-2.5 px-4 pb-4 max-h-[132px] overflow-y-auto custom-scroll")
      each d in draws key d.id
        div(className="flex items-center justify-between gap-2")
          div(className="flex gap-1")
            each n in d.sorted key n
              span(className={`w-6 h-6 rounded-full text-[10px] font-black flex items-center justify-center ${d.isOfficial ? 'bg-primary text-primary-foreground' : 'bg-ball text-ball-ink'}`})
                | #{n}
          span(className="text-[10px] text-muted-foreground font-mono shrink-0")
            | #{d.game}
            | #{" • "}
            | #{d.time}
            | #{d.isOfficial ? ' • OFFICIAL' : ''}
