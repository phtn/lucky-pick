import { Dices, Trash2, Trophy } from '@octanejs/lucide';
import { formatPeso } from '../lib/format';
import { BET_LABELS, VISIBLE_TICKETS, type Draw, type Ticket } from '../lib/lotto';

module
  // Solo mode's ticket stack. Every open ticket still settles on a draw; only
  // the newest VISIBLE_TICKETS are rendered.
  interface TicketListProps {
    tickets: Ticket[];
    /** Used to mark which numbers a settled ticket actually hit. */
    draws: Draw[];
    onClear: () => void;
  }

props { tickets, draws, onClear }: TicketListProps

div(className="px-5 py-3")
  div(className="flex items-center justify-between mb-1")
    h2(className="text-xs font-bold tracking-[0.12em] flex items-center gap-2")
      | #{" MY TICKETS"}
    div(className="flex items-center gap-2")
      span(className="flex items-center justify-center aspect-square size-6 rounded-full bg-elevated/40 text-xs font-bold")
        | #{tickets.length}
      if tickets.length > 0
        button(
          ~ onClick={onClear}
          ~ className="w-8 h-8 rounded-full bg-raised flex items-center justify-center text-muted-foreground hover:text-destructive hover:bg-destructive/15 transition"
          ~ )
          Trash2(className="w-3.5 h-3.5")
  if tickets.length === 0
    div(className="py-12 text-center ")
      p(className="text-[13px] text-muted-foreground font-medium")
        | No bets yet
  else
    div(className="space-y-2.5 max-h-[520px] overflow-y-auto custom-scroll pr-1")
      if tickets.length > VISIBLE_TICKETS
        p(className="text-[10px] text-muted-foreground/70 font-bold text-center py-1")
          | #{"Showing the latest "}
          | #{VISIBLE_TICKETS}
          | #{" of "}
          | #{tickets.length}
          | #{" tickets — every one still settles on a draw."}
      each t in tickets.slice(0, VISIBLE_TICKETS) key t.id
        div(className={`flex items-center justify-between rounded-[16px] p-1.5 transition ${t.status === 'won' ? 'bg-gradient-to-br from-primary/20 to-primary/5' : t.status === 'lost' ? 'bg-raised opacity-70' : 'bg-raised'}`})
          div(className="flex flex-wrap gap-0.5")
            each n in t.numbers key n
              span(className={`w-7 h-7 rounded-full text-[11px] font-black flex items-center justify-center transition ${(t.status !== 'pending') && (draws.find(d => d.game === t.game)?.sorted.includes(n)) ? 'bg-primary text-primary-foreground' : (t.status !== 'pending') ? 'bg-elevated/60 text-muted-foreground' : 'bg-ball text-ball-ink'}`})
                | #{n}
          div(className="flex items-center justify-between text-[10px] text-muted-foreground font-mono")
            span(className=" flex items-center gap-1.5")
              if t.status === 'won'
                span WIN
              elseif t.status === 'lost'
                span LOST
              span(className="px-1.5 py-0.5 rounded-full bg-elevated text-foreground/70 font-bold")
                | #{BET_LABELS[t.betType] + '' + t.game}
              | #{t.time}

          if t.status !== 'pending'
            div(className="hidden mt-2 _flex items-center gap-2 text-[11px]")
              span(className={`w-5 h-5 rounded-full flex items-center justify-center ${t.status === 'won' ? 'bg-primary text-primary-foreground' : 'bg-elevated text-muted-foreground'}`})
                | #{t.status === 'won' ? '✓' : '✕'}
              span(className={t.status === 'won' ? 'text-primary font-bold' : 'text-muted-foreground'})
                | #{t.status === 'won' ? `Won ${formatPeso(t.prizeWon || 0)} — ${t.hits} hits` : `Only ${t.hits}/${t.required} matched`}
