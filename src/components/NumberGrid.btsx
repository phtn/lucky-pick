module
  // The 1..pool board plus the three shortcuts that fill it.
  interface NumberGridProps {
    pool: number;
    selected: number[];
    onToggleNumber: (n: number) => void;
    onQuickPick: () => void;
    onEvenOddMix: () => void;
    onClear: () => void;
  }

props { pool, selected, onToggleNumber, onQuickPick, onEvenOddMix, onClear }: NumberGridProps

fragment
  div(className="number-grid rounded-[18px] bg-sunken p-3")
    div(className={`number-grid__matrix grid gap-1.5 ${pool > 49 ? 'grid-cols-8' : 'grid-cols-7'}`})
      each n in Array.from({ length: pool }, (_, i) => i + 1) key n
        button(
          ~ onClick={() => onToggleNumber(n)}
          ~ className={`aspect-square rounded-full shadow-sm text-lg font-bold transition-all relative flex items-center justify-center ${(selected.includes(n)) ? 'bg-[color-mix(in_oklab,var(--destructive)_20%,transparent)] text-destructive scale-[1.06] z-10' : 'hover:scale-[1.05]'}`}
          ~ )
          | #{n}
  div(className="mt-2 grid grid-cols-3 gap-2 mt-4")
    button(
      ~ onClick={onQuickPick}
      ~ className="pill--solid text-xs rounded-md h-8 font-bold px-1"
      ~ )
      | #{"LUCKY PICK"}
    button(
      ~ onClick={onEvenOddMix}
      ~ className=" text-xs rounded-md h-8 font-bold px-1"
      ~ )
      | EVEN/ODD
    button(
      ~ onClick={onClear}
      ~ className="pill--muted text-xs rounded-md h-8 font-bold px-1"
      ~ )
      | CLEAR
