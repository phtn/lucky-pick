import { Check, Dice5 } from '@octanejs/lucide';

module
  // The 1..pool board plus the three shortcuts that fill it.
  interface NumberGridProps {
    pool: number;
    selected: number[];
    onToggleNumber: (n: number) => void;
    onQuickPick: () => void;
    onEvenOddMix: () => void;
    onClear: () => void;
  }

props { pool, selected, onToggleNumber, onQuickPick, onEvenOddMix, onClear }: NumberGridProps

fragment
  div(className="rounded-[18px] bg-sunken p-3")
    div(className={`grid gap-1.5 ${pool > 49 ? 'grid-cols-8' : 'grid-cols-7'}`})
      each n in Array.from({ length: pool }, (_, i) => i + 1) key n
        button(
          ~ onClick={() => onToggleNumber(n)}
          ~ className={`aspect-square rounded-full border border-border/10 shadow-sm text-lg font-bold transition-all relative flex items-center justify-center ${(selected.includes(n)) ? 'text-black scale-[1.06] z-10' : 'hover:scale-[1.05]'}`}
          ~ )
          | #{n}
          if (selected.includes(n))
            span(className="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-destructive rounded-full flex items-center justify-center")
              Check(className="w-2 h-2 text-foreground")
  div(className="mt-3 grid grid-cols-3 gap-2")
    button(
      ~ onClick={onQuickPick}
      ~ className="pill pill--solid text-[11px]"
      ~ )
      | #{"LUCKY PICK"}
    button(
      ~ onClick={onEvenOddMix}
      ~ className="pill text-[11px]"
      ~ )
      | EVEN/ODD
    button(
      ~ onClick={onClear}
      ~ className="pill pill--muted text-[11px]"
      ~ )
      | CLEAR
