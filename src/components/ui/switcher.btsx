module "use client";
import { useState } from 'octane'
import DropdownMenu, { DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu.btsx";
import Button from '@/components/ui/button.btsx'
import { Icon, type IconName } from "@/lib/icons";
import { useMobile } from '../table/lib/use-mobile';
import { cn } from '@/lib/utils';

module
  interface SwitcherItem {
    id: string
    label: string
    icon: IconName
    shortName?: string
    /** Secondary line under the label, e.g. an email address. */
    description?: string
    /** Avatar or logo shown in place of `icon` when it loads. */
    imageUrl?: string | null
    /** Greys the row and blocks selection; the active row is always blocked. */
    disabled?: boolean
    /** Right-aligned qualifier to the label, e.g. a short status. */
    meta?: string
  }
  /** Trailing commands that are not one of the selectable items. */
  interface SwitcherAction {
    id: string
    label: string
    labelSuffix?: string
    icon: IconName
    onSelect: () => void
    variant?: 'default' | 'destructive'
    disabled?: boolean
    /** Right-aligned qualifier to the label: a second reading of the same thing. */
    meta?: string
  }
  interface SwitcherProps {
    items: SwitcherItem[]
    title: string
    activeId?: string | null
    emptyLabel: string
    busy?: boolean
    createLabel?: string
    createLabelIcon?: IconName
    onSelect?: (item: SwitcherItem) => void
    onCreate?: () => void
    actions?: SwitcherAction[]
    icon?: IconName
    /**
     * Extra menu content — settings, toggles, submenus — rendered between the
     * create row and the trailing actions. Compose it from the same
     * `dropdown-menu.btsx` parts this component uses.
     */
    children?: unknown
    footer?: unknown
    /**
     * Colours the trigger (border, fill, text) in place of its theme defaults.
     * It replaces the `dark:`/`light:` colour classes rather than adding to
     * them, because those out-specify an unprefixed utility and would hide it.
     */
    tone?: string
    /** Shows the whole label on the trigger rather than its first word. */
    fullLabel?: boolean
    /** Keeps the chosen icon on narrow screens instead of the generic `user-settings` one. */
    keepIcon?: boolean
  }

component SwitcherRoot
  props { items, title, activeId, emptyLabel, busy = false, createLabel, createLabelIcon, onSelect, onCreate, actions, icon, children, footer, tone, fullLabel, keepIcon }: SwitcherProps
  setup
    // Omitting `activeId` falls back to the first item; passing `null` states
    // that nothing is selected, which is what drops the trigger to `emptyLabel`.
    const activeItem = activeId === undefined ? items[0] : items.find(item => item.id === activeId);
    const trigger = <Button/>;
    const triggerColour = tone ? `border ${tone}` : 'dark:bg-muted/40 hover:dark:bg-muted hover:bg-[#57ccf2] dark:text-fg dark:data-pressed:bg-panel data-pressed:bg-muted light:bg-transparent'
    const isMobile = useMobile()
    // A Google avatar is served from `lh3.googleusercontent.com`, which refuses
    // some requests outright; the refused URL is remembered so the icon takes
    // over instead of the browser's broken-image glyph. The URL is kept rather
    // than a flag, so another account's photo is still tried.
    const [brokenPhotoUrl, setBrokenPhotoUrl] = useState<string | null>(null)
    const avatarUrl =
      activeItem?.imageUrl && activeItem.imageUrl !== brokenPhotoUrl ? activeItem.imageUrl : null

  DropdownMenu
    DropdownMenuTrigger(render={trigger} className={cn('size-10', triggerColour, 'bg-transparent rounded-full overflow-hidden')} disabled={busy})
      div(className="flex aspect-square _size-6 items-center justify-center")
        if avatarUrl
          img(
            ~ src={avatarUrl}
            ~ alt=''
            ~ referrerPolicy='no-referrer'
            ~ onError={() => setBrokenPhotoUrl(avatarUrl)}
            ~ className='size-6 shrink-0 rounded-full object-cover md:size-8 drop-shadow'
            ~ )
        else
          Icon(name={isMobile && !keepIcon ? 'user-settings' : activeItem?.icon ?? icon ?? 'circle-plus'} className={cn('size-9 md:size-5', !tone && 'dark:text-foreground/70')})
      // div(className=' min-w-0 h-6 flex items-center max-[760px]:hidden')
        // span(className={cn('font-sans font-[450] text-sm tracking-tight truncate', !fullLabel && 'capitalize', !tone && 'dark:text-muted-foreground')} title={label}) #{fullLabel ? label : label.split(' ').shift()}
      // Icon(name='select-caret' className='size-2.75 ml-1 opacity-70 dark:text-foreground/40 hidden md:flex')
    DropdownMenuContent(className="min-w-54 max-w-72 bg-background" align="start" side="bottom" sideOffset={4})
      DropdownMenuGroup
        if !items
          DropdownMenuLabel(className="font-normal text-xs text-muted-foreground opacity-80") #{title}
        if items.length
          DropdownMenuSeparator
        each item in items key item.id
          DropdownMenuItem(onClick={() => onSelect?.(item)} disabled={item.disabled === true || item.id === activeItem?.id} className="gap-1 p-2 hover:bg-foreground/10!")
            div(className="flex size-6 items-center justify-center")
              // if item.imageUrl
              //   img(src={item.imageUrl} alt="" className='size-5 rounded-full object-cover')
              // else
              Icon(name={item.icon} className='size-4')

            div(className='min-w-0 flex-1')
              span(className='block truncate pe-2') #{item.label}
              if item.description
                span(className='block truncate pe-2 text-xs text-muted-foreground') #{item.description}
            // `ml-auto` rather than a spacer: a row without `meta` keeps the
            // layout it had before this slot existed.
            if item.meta
              div(className="ml-auto shrink-0 pl-3 font-sans text-sm -tracking-[0.02em] whitespace-nowrap text-muted-foreground") #{item.meta}
            if item.id === activeItem?.id
              Icon(name='check' className='size-3.5 ml-auto text-accent')
        empty
          DropdownMenuItem(disabled className='hidden p-2 text-xs text-muted-foreground') #{emptyLabel}
      if onCreate && createLabel
        DropdownMenuGroup
          DropdownMenuSeparator
          DropdownMenuItem(onClick={onCreate} className="gap-1 p-2 text-muted-foreground hover:bg-muted-foreground/10! hover:text-accent")
            div(className="flex size-6 items-center justify-center rounded-md")
              Icon(name={createLabelIcon ?? 'plus'} className='size-3.5')
            div(className="font-sans text-sm -tracking-[0.02em]") #{createLabel}

      if actions && actions.length
        DropdownMenuGroup
          DropdownMenuSeparator
          each action in actions key action.id
            DropdownMenuItem(onClick={action.onSelect} disabled={action.disabled} variant={action.variant ?? 'default'} className="flex items-center gap-1 p-2 text-foreground/80 hover:bg-muted-foreground/10! hover:text-accent")
              div(className="flex size-6 items-center justify-center rounded-md")
                Icon(name={action.icon} className='size-4')
              // `whitespace-nowrap`: a figure is read as one word, and in a
              // narrow menu `2,000.00 TRX` otherwise breaks after the amount and
              // leaves its unit alone on a second line.
              div(className="flex items-center gap-1")
                span(className="font-sans text-sm -tracking-[0.02em] whitespace-nowrap") #{action.label}
                span(className="font-mono font-bold text-sm tracking-tight whitespace-nowrap text-foreground/70") #{action.labelSuffix}
              // `ml-auto` rather than a spacer: a row without `meta` keeps the
              // layout it had before this slot existed.
              if action.meta
                div(className="ml-auto shrink-0 pl-3 font-sans text-sm -tracking-[0.02em] whitespace-nowrap text-muted-foreground") #{action.meta}
      if children
        DropdownMenuGroup(children={children})
      if footer
        DropdownMenuGroup(children={footer})

module
  export type { SwitcherItem, SwitcherAction, SwitcherProps }

props {...props}: SwitcherProps
SwitcherRoot({...props})
