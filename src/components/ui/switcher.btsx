module "use client";
import DropdownMenu, { DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu.btsx";
import Button from '@/components/ui/button.btsx'
import { Icon, type IconName } from "@/lib/icons";

module
  interface SwitcherItem {
    id: string
    label: string
    icon: IconName
  }
  interface SwitcherProps {
    items: SwitcherItem[]
    title: string
    activeId?: string | null
    emptyLabel: string
    busy?: boolean
    createLabel?: string
    createLabelIcon?: IconName
    onSelect?: (item: SwitcherItem) => void
    onCreate?: () => void
    icon? IconName
  }

component SwitcherRoot
  props { items, title, activeId, emptyLabel, busy = false, createLabel, createLabelIcon, onSelect, onCreate, icon }: SwitcherProps
  setup
    const activeItem = items.find(item => item.id === activeId) ?? items[0];
    const trigger = <Button/>;
    const label = busy ? 'Loading…' : activeItem?.label ?? emptyLabel;

  DropdownMenu
    DropdownMenuTrigger(render={trigger} className='bg-background/80 dark:bg-muted/50 hover:dark:bg-muted text-fg hover:bg-background/90 data-pressed:bg-background px-1 gap-0 light:border ligbn rounded-lg light:bg-panel shadow-xs light:shadow-elevation' disabled={busy})
      div(className="flex aspect-square size-6 items-center justify-center")
        Icon(name={activeItem?.icon ?? icon ?? 'circle-plus'} className='size-3.5 text-accent')
      div(className=' min-w-0 h-6 flex items-center max-[760px]:hidden')
        span(className='font-sans font-normal text-muted-foreground text-sm -tracking-[0.02em] truncate capitalize' title={label}) #{label}
      Icon(name='select-caret' className='size-3 ml-1 opacity-70')
    DropdownMenuContent(className="min-w-44 max-w-72 bg-background" align="start" side="bottom" sideOffset={4})
      DropdownMenuGroup
        DropdownMenuLabel(className="font-normal text-xs text-muted-foreground opacity-80") #{title}
        if items.length
          DropdownMenuSeparator
        each item in items key item.id
          DropdownMenuItem(onClick={() => onSelect?.(item)} disabled={item.id === activeItem?.id} className="gap-1 p-2 hover:bg-foreground/10!")
            div(className="flex size-6 items-center justify-center")
              Icon(name={item.icon} className='size-4')
            span(className='truncate pe-2') #{item.label}
        empty
          DropdownMenuItem(disabled className='hidden p-2 text-xs text-muted-foreground') #{emptyLabel}
      if onCreate && createLabel
        DropdownMenuGroup
          DropdownMenuSeparator
          DropdownMenuItem(onClick={onCreate} className="gap-1 p-2 text-muted-foreground hover:bg-muted-foreground/10! hover:text-accent")
            div(className="flex size-6 items-center justify-center rounded-md")
              Icon(name={createLabelIcon ?? 'plus'} className='size-3.5')
            div(className="font-sans text-sm -tracking-[0.02em]") #{createLabel}

props {...props}: SwitcherProps
SwitcherRoot({...props})
