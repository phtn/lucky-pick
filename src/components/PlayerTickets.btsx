import { useMemo } from 'octane';
import { Trash2, Users } from '@octanejs/lucide';
import { formatPeso } from '../lib/format';
import { BET_LABELS, VISIBLE_TICKETS, rankTickets, type Draw, type Player } from '../lib/lotto';
import type { GameId } from '../lib/games';

module
  // The selected party player's own stack, below the leaderboard.
  interface PlayerTicketsProps {
    /** Undefined only while the roster is empty. */
    player?: Player;
    draws: Draw[];
    /** Balls revealed so far in the running draw; drives the live ordering. */
    drawnBalls: number[];
    /** Which game those balls belong to, or null when no draw has started. */
    drawGame: GameId | null;
    onClearTickets: () => void;
  }

props { player, draws, drawnBalls, drawGame, onClearTickets }: PlayerTicketsProps
setup
  // Same live ranking as the solo stack: most drawn numbers held goes first.
  const ranked = useMemo(() => rankTickets(player?.tickets ?? [], drawnBalls, drawGame), [player, drawnBalls, drawGame]);
  const liveDrawn = useMemo(() => new Set(drawnBalls), [drawnBalls]);

div(className="lux-panel p-5")
  h3(className="text-[12px] font-black tracking-widest mb-3 flex items-center gap-2")
    Users(className="w-4 h-4 text-foreground/70")
    | #{" "}
    | #{player?.name}
    | #{"'S TICKETS • "}
    | #{player?.tickets.length}
  div(className="space-y-2 max-h-[260px] overflow-y-auto custom-scroll pr-1")
    if (player?.tickets || []).length === 0
      p(className="text-[12px] text-muted-foreground/70 py-6 text-center")
        | #{"No tickets yet for "}
        | #{player?.name}
    else
      each r, idx in ranked.slice(0, VISIBLE_TICKETS) key r.ticket.id
        div(className={`rounded-[14px] p-2.5 flex items-center justify-between ${r.ticket.status === 'won' ? 'bg-primary/15' : r.ticket.status === 'lost' ? 'bg-raised opacity-70' : idx === 0 && r.hits > 0 ? 'bg-raised ring-1 ring-primary/50' : 'bg-raised'}`})
          div(className="flex gap-1 flex-wrap")
            span(className="px-1.5 h-6 rounded-full bg-elevated text-[9px] font-black text-muted-foreground flex items-center")
              | #{r.ticket.game}
            each n in r.ticket.numbers key n
              span(className={`w-6 h-6 rounded-full text-[10px] font-black flex items-center justify-center ${(r.ticket.game === drawGame && liveDrawn.has(n)) || (r.ticket.status !== 'pending' && draws.find(d => d.game === r.ticket.game)?.sorted.includes(n)) ? 'bg-primary text-primary-foreground' : 'bg-ball text-ball-ink'}`})
                | #{n}
          span(className="text-[10px] font-bold")
            | #{r.ticket.status === 'won' ? formatPeso(r.ticket.prizeWon || 0) : r.ticket.status === 'lost' ? `${r.ticket.hits}/${r.ticket.required}` : r.hits > 0 ? `${r.hits} HIT${r.hits === 1 ? '' : 'S'}` : BET_LABELS[r.ticket.betType]}
  button(
    ~ onClick={onClearTickets}
    ~ className="pill pill--muted mt-3 w-full text-[11px]"
    ~ )
    Trash2(className="w-3.5 h-3.5")
    | #{" Clear "}
    | #{player?.name}
    | 's tickets
