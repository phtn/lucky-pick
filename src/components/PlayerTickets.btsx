import { Trash2, Users } from '@octanejs/lucide';
import { formatPeso } from '../lib/format';
import { BET_LABELS, VISIBLE_TICKETS, type Draw, type Player } from '../lib/lotto';

module
  // The selected party player's own stack, below the leaderboard.
  interface PlayerTicketsProps {
    /** Undefined only while the roster is empty. */
    player?: Player;
    draws: Draw[];
    onClearTickets: () => void;
  }

props { player, draws, onClearTickets }: PlayerTicketsProps

div(className="lux-panel p-5")
  h3(className="text-[12px] font-black tracking-widest mb-3 flex items-center gap-2")
    Users(className="w-4 h-4 text-foreground/70")
    | #{" "}
    | #{player?.name}
    | #{"'S TICKETS • "}
    | #{player?.tickets.length}
  div(className="space-y-2 max-h-[260px] overflow-y-auto custom-scroll pr-1")
    if (player?.tickets || []).length === 0
      p(className="text-[12px] text-muted-foreground/70 py-6 text-center")
        | #{"No tickets yet for "}
        | #{player?.name}
    else
      each t in (player?.tickets ?? []).slice(0, VISIBLE_TICKETS) key t.id
        div(className={`rounded-[14px] border p-2.5 flex items-center justify-between ${t.status === 'won' ? 'bg-primary/15 border-primary/30' : t.status === 'lost' ? 'bg-raised border-border opacity-70' : 'bg-raised border-border'}`})
          div(className="flex gap-1 flex-wrap")
            span(className="px-1.5 h-6 rounded-full bg-elevated border border-border text-[9px] font-black text-muted-foreground flex items-center")
              | #{t.game}
            each n in t.numbers key n
              span(className={`w-6 h-6 rounded-full text-[10px] font-black flex items-center justify-center ${t.status !== 'pending' && draws.find(d => d.game === t.game)?.sorted.includes(n) ? 'bg-primary text-primary-foreground' : 'bg-ball text-ball-ink'}`})
                | #{n}
          span(className="text-[10px] font-bold")
            | #{t.status === 'won' ? formatPeso(t.prizeWon || 0) : t.status === 'lost' ? `${t.hits}/${t.required}` : BET_LABELS[t.betType]}
  button(
    ~ onClick={onClearTickets}
    ~ className="mt-3 w-full h-9 rounded-full bg-raised border border-border text-[11px] font-bold hover:bg-elevated flex items-center justify-center gap-1"
    ~ )
    Trash2(className="w-3.5 h-3.5")
    | #{" Clear "}
    | #{player?.name}
    | 's tickets
