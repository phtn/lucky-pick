import { GAME_IDS, GAMES, type GameConfig, type GameId } from '../lib/games';
import { formatCompactPeso } from '../lib/format';
import { cn } from '../lib/utils';

module
  interface GameSwitcherProps {
    game: GameConfig;
    gameId: GameId;
    /** Current rolling pot per game, so each chip shows its own headline. */
    jackpots: Record<GameId, number>;
    /** A draw in flight locks the switcher. */
    isDrawing: boolean;
    onSwitchGame: (next: GameId) => void;
  }

props { game, gameId, jackpots, isDrawing, onSwitchGame }: GameSwitcherProps

div(className="mb-4")
  div(className="game-rail py-4")
    each g in GAME_IDS key g
      button(
        ~ onClick={() => onSwitchGame(g)}
        ~ disabled={isDrawing}
        ~ className={cn('game-chip', { 'game-chip--active': gameId === g })}
        ~ )
        span(className="flex items-baseline gap-4 font-bold leading-none tracking-[-0.02em]")
          span(className="text-base")
            | #{g}
          span(className={cn('text-base font-semibold text-primary', { 'text-[color:var(--primary-foreground)]': gameId === g })})
            | #{formatCompactPeso(jackpots[g])}
        span(className={cn('block text-[9px] font-bold tracking-[0.14em] mt-1.5 truncate text-muted-foreground', { 'text-[color:var(--primary-foreground)] opacity-80': gameId === g })})
          | #{GAMES[g].name.toUpperCase()}
  p(className="mt-2 px-0.5 text-[10px] font-semibold tracking-[0.1em] text-muted-foreground/70 uppercase")
    | #{game.drawDayLabel}
    | #{" • 9PM Manila • Pool 1-"}
    | #{game.pool}
