{
  "name": "lucky-pick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "cf:preview": "bun run build && wrangler dev",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check"
  },
  "dependencies": {
    "@beastjs/use-rng": "^0.1.25",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@octanejs/base-ui": "0.1.59",
    "@octanejs/cmdk": "0.1.43",
    "@octanejs/day-picker": "0.0.25",
    "@octanejs/dnd-kit": "0.1.53",
    "@octanejs/lucide": "0.1.53",
    "@octanejs/nuqs": "^0.1.49",
    "@octanejs/select": "0.1.9",
    "@octanejs/shadcn": "0.0.48",
    "@octanejs/tanstack-table": "0.1.58",
    "beast-tsrx": "0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "octane": "0.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@octanejs/rsbuild-plugin": "0.1.58",
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/typescript-plugin": "0.6.1",
    "@types/node": "^26.6.4",
    "@types/bun": "^1.4.2",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
